---
import { base, withBase } from '../utils/paths'
interface Props { current?: string; theme?: 'dark' | 'light' }
const { current = 'Home' } = Astro.props
const links = [
  { label: 'Home', href: base }, { label: 'Journal', href: withBase('journal') },
  { label: 'Notes', href: withBase('notes') },
  { label: 'Labs', href: withBase('labs') }, { label: 'Projects', href: withBase('projects') },
  { label: 'Writeups', href: withBase('writeups') },
  { label: 'Achievements', href: withBase('achievements') }, { label: 'Skills', href: withBase('skills') },
  { label: 'Archive', href: withBase('archive') },
]
---
<header class="site-nav">
  <nav><a href={base} class="site-brand" aria-label="Yaohan home">YH.</a>
    <div class="nav-links" id="primary-nav">{links.map((link) => <a href={link.href} class:list={[{ active: link.label === current }]}>{link.label}</a>)}</div>
    <a class="nav-contact" href="mailto:2503587D@student.tp.edu.sg">CONTACT ↗</a>
  </nav>
</header>
<div class="page-progress" aria-hidden="true"><span></span></div>
<style is:inline>
  .site-nav nav { gap: 12px; }
  .site-nav .nav-toggle { display: none !important; }
  .site-nav .nav-links,
  .home-clean .site-nav .nav-links {
    position: static !important;
    display: flex !important;
    flex: 1 1 auto;
    min-width: 0;
    width: auto !important;
    padding: 0 !important;
    align-items: center !important;
    justify-content: center;
    gap: 3px;
    flex-direction: row !important;
    overflow-x: auto;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: none !important;
    translate: 0 !important;
    scrollbar-width: none;
  }
  .site-nav .nav-links::-webkit-scrollbar { display: none; }
  .site-nav .nav-links a,
  .home-clean .site-nav .nav-links a {
    display: block;
    flex: 0 0 auto;
    padding: 10px 10px !important;
    white-space: nowrap;
  }
  @media (max-width: 1180px) {
    .site-nav .nav-contact,
    .home-clean .site-nav .nav-contact { display: none; }
    .site-nav .nav-links,
    .home-clean .site-nav .nav-links { justify-content: flex-start; }
  }
  @media (max-width: 680px) {
    .site-nav nav,
    .home-clean .site-nav nav { padding-inline: 12px !important; }
    .site-nav .site-brand { flex: 0 0 auto; }
    .site-nav .nav-links,
    .home-clean .site-nav .nav-links {
      gap: 0;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 18px), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 18px), transparent 100%);
    }
    .site-nav .nav-links a,
    .home-clean .site-nav .nav-links a { padding-inline: 9px !important; }
  }
</style>
<script is:inline data-astro-rerun>
  const progress = document.querySelector('.page-progress span');
  const updateProgress = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener('scroll', updateProgress, { passive: true }); updateProgress();
</script>
