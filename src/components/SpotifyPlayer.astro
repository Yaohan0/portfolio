---
const playlistId = '5iLaYhjaKk2VL7YME84aRG'
const playlistUri = `spotify:playlist:${playlistId}`
const playlistUrl = `https://open.spotify.com/playlist/${playlistId}`
---

<aside
  class="music-player"
  data-music-player
  data-state="paused"
  data-collapsed="false"
  data-expanded="true"
  transition:persist="site-music-player"
  aria-label="Spotify background music player"
>
  <button class="music-player__mini" type="button" data-player-expand aria-label="Open music player">
    <span aria-hidden="true">♫</span>
  </button>

  <div class="music-player__panel">
    <div class="music-player__artwork" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.58 14.42a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.1-10.55-1.15a.75.75 0 1 1-.33-1.46c4.58-1.04 8.5-.6 11.66 1.33.35.21.46.67.25 1.03Zm1.47-3.26a.94.94 0 0 1-1.29.31c-3.23-1.98-8.15-2.55-11.97-1.4a.94.94 0 1 1-.54-1.8c4.37-1.32 9.8-.68 13.49 1.59.44.27.58.85.31 1.3Zm.13-3.39C14.3 7.47 7.9 7.26 4.2 8.38A1.13 1.13 0 0 1 3.55 6.2c4.25-1.28 11.33-1.04 15.78 1.6a1.13 1.13 0 0 1-1.15 1.95Z" /></svg>
      <span class="music-player__equalizer"><i></i><i></i><i></i></span>
    </div>

    <div class="music-player__copy">
      <p>SPOTIFY · PORTFOLIO MIX</p>
      <a href={playlistUrl} target="_blank" rel="noreferrer">
        <strong>Yaohan’s playlist</strong>
        <span>Open the full track list ↗</span>
      </a>
    </div>

    <div class="music-player__controls">
      <button type="button" data-player-toggle aria-label="Play background music">
        <span class="music-player__play" aria-hidden="true">▶</span>
        <span class="music-player__pause" aria-hidden="true">Ⅱ</span>
      </button>
      <button type="button" data-player-list aria-label="Show Spotify playlist" aria-expanded="false">⌄</button>
      <button type="button" data-player-collapse aria-label="Minimise music player">−</button>
    </div>
  </div>

  <div class="music-player__playlist" data-player-playlist>
    <div id="spotify-playlist-player" data-player-engine></div>
  </div>
  <p class="music-player__notice" data-player-notice>
    Spotify Premium plays the complete songs. If Spotify shows a preview, open the playlist and sign in once in this browser.
  </p>
</aside>

<script is:inline define:vars={{ playlistUri }}>
  (() => {
    const root = document.querySelector('[data-music-player]');
    if (!root || root.dataset.initialised === 'true') return;
    root.dataset.initialised = 'true';

    const engine = root.querySelector('[data-player-engine]');
    const toggle = root.querySelector('[data-player-toggle]');
    const list = root.querySelector('[data-player-list]');
    const collapse = root.querySelector('[data-player-collapse]');
    const expand = root.querySelector('[data-player-expand]');
    const notice = root.querySelector('[data-player-notice]');
    const storage = {
      intent: 'yh.music.intent',
      collapsed: 'yh.music.collapsed',
      expanded: 'yh.music.expanded',
    };

    let controller;
    let ready = false;
    let desiredPlaying = localStorage.getItem(storage.intent) === 'playing';

    const setPlaying = (playing) => {
      root.dataset.state = playing ? 'playing' : 'paused';
      toggle?.setAttribute('aria-label', playing ? 'Pause background music' : 'Play background music');
    };

    const setExpanded = (expanded) => {
      root.dataset.expanded = String(expanded);
      list?.setAttribute('aria-expanded', String(expanded));
      list?.setAttribute('aria-label', expanded ? 'Hide Spotify playlist' : 'Show Spotify playlist');
      localStorage.setItem(storage.expanded, String(expanded));
    };

    const requestPlay = () => {
      desiredPlaying = true;
      localStorage.setItem(storage.intent, 'playing');
      if (ready) controller.resume();
    };

    const requestPause = () => {
      desiredPlaying = false;
      localStorage.setItem(storage.intent, 'paused');
      if (ready) controller.pause();
      setPlaying(false);
    };

    root.dataset.collapsed = localStorage.getItem(storage.collapsed) === 'true' ? 'true' : 'false';
    setExpanded(localStorage.getItem(storage.expanded) !== 'false');

    toggle?.addEventListener('click', () => {
      if (root.dataset.state === 'playing') requestPause();
      else requestPlay();
    });
    list?.addEventListener('click', () => setExpanded(root.dataset.expanded !== 'true'));
    collapse?.addEventListener('click', () => {
      root.dataset.collapsed = 'true';
      localStorage.setItem(storage.collapsed, 'true');
    });
    expand?.addEventListener('click', () => {
      root.dataset.collapsed = 'false';
      localStorage.setItem(storage.collapsed, 'false');
    });
    window.addEventListener('portfolio:enter-requested', requestPlay);

    const initialise = (IFrameAPI) => {
      if (!engine || controller) return;
      IFrameAPI.createController(engine, {
        uri: playlistUri,
        width: '100%',
        height: 352,
      }, (EmbedController) => {
        controller = EmbedController;
        const spotifyFrame = root.querySelector('iframe');
        if (spotifyFrame) {
          spotifyFrame.setAttribute('allow', 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture');
          spotifyFrame.setAttribute('allowfullscreen', '');
        }
        controller.addListener('ready', () => {
          ready = true;
          const hasEntryGate = Boolean(document.querySelector('[data-entry-loader]'));
          if (!hasEntryGate && desiredPlaying) controller.resume();
        });
        controller.addListener('playback_started', () => setPlaying(true));
        controller.addListener('playback_update', (event) => {
          const state = event?.data;
          if (!state) return;
          root.dataset.position = String(Math.round(state.position || 0));
          root.dataset.playingUri = state.playingURI || '';
          setPlaying(!state.isPaused && !state.isBuffering);
          if (notice && state.duration > 0) {
            const previewMode = state.duration <= 31000;
            notice.dataset.mode = previewMode ? 'preview' : 'full';
            notice.textContent = previewMode
              ? 'Preview mode detected — open the playlist, sign in to Spotify in this browser, then refresh once.'
              : 'Full-track Spotify playback is active.';
          }
        });
      });
    };

    if (window.__yhSpotifyIframeApi) {
      initialise(window.__yhSpotifyIframeApi);
      return;
    }

    const previousReady = window.onSpotifyIframeApiReady;
    window.onSpotifyIframeApiReady = (IFrameAPI) => {
      window.__yhSpotifyIframeApi = IFrameAPI;
      if (typeof previousReady === 'function') previousReady(IFrameAPI);
      initialise(IFrameAPI);
    };

    if (!document.querySelector('script[data-yh-spotify-api]')) {
      const apiScript = document.createElement('script');
      apiScript.src = 'https://open.spotify.com/embed/iframe-api/v1';
      apiScript.async = true;
      apiScript.dataset.yhSpotifyApi = 'true';
      document.body.append(apiScript);
    }
  })();
</script>

<style>
  .music-player {
    --player-accent: #1ed760;
    position: fixed;
    z-index: 80;
    right: 22px;
    bottom: 22px;
    width: min(390px, calc(100vw - 32px));
    color: #f4f3ef;
    filter: drop-shadow(0 24px 42px rgba(0, 0, 0, .48));
    transition: opacity .25s ease, transform .25s ease, width .25s ease;
  }
  :global(html.entry-is-loading) .music-player { opacity: 0; pointer-events: none; transform: translateY(14px); }
  .music-player__panel {
    min-height: 100px;
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    padding: 11px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(27,29,31,.96), rgba(8,9,11,.97));
    backdrop-filter: blur(20px) saturate(1.15);
  }
  .music-player__artwork { position: relative; width: 78px; aspect-ratio: 1; display: grid; place-items: center; overflow: hidden; border-radius: 12px; background: radial-gradient(circle at 35% 25%, #303a34, #0e100f 67%); }
  .music-player__artwork svg { width: 40px; fill: var(--player-accent); }
  .music-player__equalizer { position: absolute; left: 8px; bottom: 8px; height: 20px; display: flex; align-items: end; gap: 2px; padding: 4px; border-radius: 6px; background: rgba(2,3,5,.72); }
  .music-player__equalizer i { display: block; width: 2px; height: 5px; background: var(--player-accent); transform-origin: bottom; }
  .music-player[data-state='playing'] .music-player__equalizer i { animation: player-eq .72s ease-in-out infinite alternate; }
  .music-player[data-state='playing'] .music-player__equalizer i:nth-child(2) { animation-delay: -.44s; }
  .music-player[data-state='playing'] .music-player__equalizer i:nth-child(3) { animation-delay: -.21s; }
  .music-player__copy { min-width: 0; }
  .music-player__copy p { margin: 0 0 7px; color: #7c817e; font: 650 8px/1 'JetBrains Mono', monospace; letter-spacing: .13em; }
  .music-player__copy a { display: block; min-width: 0; }
  .music-player__copy strong, .music-player__copy span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .music-player__copy strong { color: #f4f3ef; font: 700 14px/1.22 'Space Grotesk', sans-serif; }
  .music-player__copy a > span { margin-top: 5px; color: #9b9da2; font-size: 11px; }
  .music-player__copy a:hover strong { color: var(--player-accent); }
  .music-player__controls { align-self: stretch; display: grid; grid-template-columns: 38px 28px; grid-template-rows: 28px 1fr; align-items: center; gap: 4px; }
  .music-player__controls button, .music-player__mini { border: 0; color: #f4f3ef; cursor: pointer; }
  .music-player__controls button { background: transparent; }
  .music-player__controls [data-player-toggle] { grid-row: 2; width: 38px; height: 38px; border-radius: 50%; color: #071108; background: var(--player-accent); font-size: 11px; }
  .music-player__controls [data-player-list] { grid-column: 2; grid-row: 2; color: #b8bac0; font-size: 22px; line-height: 1; transition: transform .2s ease; }
  .music-player[data-expanded='true'] .music-player__controls [data-player-list] { transform: rotate(180deg); }
  .music-player__controls [data-player-collapse] { grid-column: 2; grid-row: 1; color: #7e8188; font-size: 17px; }
  .music-player__pause { display: none; font-size: 10px; letter-spacing: -2px; transform: translateX(-1px); }
  .music-player[data-state='playing'] .music-player__pause { display: inline; }
  .music-player[data-state='playing'] .music-player__play { display: none; }
  .music-player__playlist { display: grid; grid-template-rows: 0fr; margin-top: 7px; overflow: hidden; border-radius: 12px; opacity: 0; transition: grid-template-rows .28s ease, opacity .2s ease; }
  .music-player__playlist > div { min-height: 0; overflow: hidden; }
  .music-player[data-expanded='true'] .music-player__playlist { grid-template-rows: 1fr; opacity: 1; }
  :global(.music-player__playlist iframe) { display: block; width: 100%; height: 352px; border: 0; border-radius: 12px; }
  .music-player__notice { margin: 8px 8px 0; color: #8b8f8c; font: 600 8px/1.45 'JetBrains Mono', monospace; letter-spacing: .06em; text-align: center; }
  .music-player__notice[data-mode='full'] { color: var(--player-accent); }
  .music-player__notice[data-mode='preview'] { color: #ffb05d; }
  .music-player__mini { display: none; width: 54px; height: 54px; margin-left: auto; border: 1px solid rgba(255,255,255,.15); border-radius: 50%; background: rgba(12,13,15,.92); backdrop-filter: blur(18px); }
  .music-player__mini span { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: #071108; background: var(--player-accent); font-size: 17px; }
  .music-player[data-collapsed='true'] { width: 54px; }
  .music-player[data-collapsed='true'] .music-player__panel, .music-player[data-collapsed='true'] .music-player__playlist, .music-player[data-collapsed='true'] .music-player__notice { display: none; }
  .music-player[data-collapsed='true'] .music-player__mini { display: block; }
  @keyframes player-eq { from { transform: scaleY(.55); } to { transform: scaleY(2.7); } }
  @media (max-width: 620px) {
    .music-player { right: 14px; bottom: 14px; width: min(350px, calc(100vw - 28px)); }
    .music-player__panel { grid-template-columns: 68px minmax(0, 1fr) auto; min-height: 90px; }
    .music-player__artwork { width: 68px; }
    .music-player__copy strong { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .music-player, .music-player__playlist, .music-player__equalizer i { animation: none !important; transition: none !important; }
  }
</style>
