---
const tracks = [
  {
    title: 'How To Train Your Dragon Epic Theme — Just Free',
    artist: 'Lucas Ricciotti',
    url: 'https://soundcloud.com/lucasricciotti/how-to-train-your-dragon-epic-theme-just-free',
    artwork: 'https://i1.sndcdn.com/artworks-EmNQvkZ3SU4mBJLh-azUe8Q-t500x500.jpg',
  },
]

const initialPlayerUrl = `https://w.soundcloud.com/player/?url=${encodeURIComponent(tracks[0].url)}&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&visual=false`
---

<aside class="music-player" data-music-player data-state="paused" data-collapsed="false" aria-label="Background music player">
  <button class="music-player__mini" type="button" data-player-expand aria-label="Open music player">
    <span aria-hidden="true">♫</span>
  </button>

  <div class="music-player__panel">
    <div class="music-player__artwork">
      <img src={tracks[0].artwork} alt="" data-player-artwork />
      <span class="music-player__equalizer" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>

    <div class="music-player__copy">
      <p><span data-player-index>01</span> / <span>{String(tracks.length).padStart(2, '0')}</span> · NOW PLAYING</p>
      <a href={tracks[0].url} target="_blank" rel="noreferrer" data-player-link>
        <strong data-player-title>{tracks[0].title}</strong>
        <span data-player-artist>{tracks[0].artist}</span>
      </a>
    </div>

    <div class="music-player__controls">
      <button type="button" data-player-toggle aria-label="Play background music">
        <span class="music-player__play" aria-hidden="true">▶</span>
        <span class="music-player__pause" aria-hidden="true">Ⅱ</span>
      </button>
      <button type="button" data-player-next aria-label="Next track" disabled={tracks.length < 2}>›</button>
      <button type="button" data-player-collapse aria-label="Minimise music player">−</button>
    </div>

    <label class="music-player__volume">
      <span>VOL</span>
      <input type="range" min="0" max="100" value="52" data-player-volume aria-label="Music volume" />
    </label>
  </div>

  <iframe
    class="music-player__engine"
    data-player-engine
    title="SoundCloud background music"
    width="166"
    height="166"
    scrolling="no"
    frameborder="no"
    allow="autoplay; encrypted-media"
    src={initialPlayerUrl}
  ></iframe>
</aside>

<script is:inline src="https://w.soundcloud.com/player/api.js"></script>
<script is:inline define:vars={{ tracks }}>
  (() => {
    const root = document.querySelector('[data-music-player]');
    if (!root || !window.SC?.Widget) return;

    const engine = root.querySelector('[data-player-engine]');
    const toggle = root.querySelector('[data-player-toggle]');
    const next = root.querySelector('[data-player-next]');
    const collapse = root.querySelector('[data-player-collapse]');
    const expand = root.querySelector('[data-player-expand]');
    const volume = root.querySelector('[data-player-volume]');
    const title = root.querySelector('[data-player-title]');
    const artist = root.querySelector('[data-player-artist]');
    const artwork = root.querySelector('[data-player-artwork]');
    const link = root.querySelector('[data-player-link]');
    const indexLabel = root.querySelector('[data-player-index]');
    const widget = window.SC.Widget(engine);
    const storage = {
      intent: 'yh.music.intent',
      track: 'yh.music.track',
      volume: 'yh.music.volume',
      position: 'yh.music.position',
      collapsed: 'yh.music.collapsed',
    };

    let trackIndex = Math.min(Number(localStorage.getItem(storage.track)) || 0, tracks.length - 1);
    let desiredPlaying = localStorage.getItem(storage.intent) === 'playing';
    let ready = false;
    let pendingPlay = false;
    let lastSavedAt = 0;

    const setPlaying = (playing) => {
      root.dataset.state = playing ? 'playing' : 'paused';
      toggle.setAttribute('aria-label', playing ? 'Pause background music' : 'Play background music');
    };

    const updateTrack = () => {
      const track = tracks[trackIndex];
      title.textContent = track.title;
      artist.textContent = track.artist;
      artwork.src = track.artwork;
      link.href = track.url;
      indexLabel.textContent = String(trackIndex + 1).padStart(2, '0');
      localStorage.setItem(storage.track, String(trackIndex));
    };

    const requestPlay = () => {
      desiredPlaying = true;
      pendingPlay = true;
      localStorage.setItem(storage.intent, 'playing');
      if (ready) widget.play();
    };

    const requestPause = () => {
      desiredPlaying = false;
      pendingPlay = false;
      localStorage.setItem(storage.intent, 'paused');
      if (ready) widget.pause();
      setPlaying(false);
    };

    const loadTrack = (shouldPlay = desiredPlaying) => {
      updateTrack();
      ready = false;
      pendingPlay = shouldPlay;
      widget.load(tracks[trackIndex].url, {
        auto_play: shouldPlay,
        hide_related: true,
        show_comments: false,
        show_user: false,
        show_reposts: false,
        visual: false,
      });
    };

    updateTrack();
    const savedVolume = Math.max(0, Math.min(100, Number(localStorage.getItem(storage.volume)) || 52));
    volume.value = String(savedVolume);
    root.dataset.collapsed = localStorage.getItem(storage.collapsed) === 'true' ? 'true' : 'false';

    widget.bind(window.SC.Widget.Events.READY, () => {
      ready = true;
      widget.setVolume(Number(volume.value));
      const savedTrack = Number(localStorage.getItem(storage.track));
      if (savedTrack === trackIndex) {
        const savedPosition = Number(localStorage.getItem(storage.position));
        if (Number.isFinite(savedPosition) && savedPosition > 0) widget.seekTo(savedPosition);
      }
      const hasEntryGate = Boolean(document.querySelector('[data-entry-loader]'));
      if (hasEntryGate) {
        widget.pause();
        setPlaying(false);
      } else if (pendingPlay || desiredPlaying) {
        widget.play();
      }
    });
    widget.bind(window.SC.Widget.Events.PLAY, () => setPlaying(true));
    widget.bind(window.SC.Widget.Events.PAUSE, () => setPlaying(false));
    widget.bind(window.SC.Widget.Events.PLAY_PROGRESS, (event) => {
      const now = Date.now();
      if (now - lastSavedAt < 1600) return;
      lastSavedAt = now;
      localStorage.setItem(storage.position, String(Math.round(event.currentPosition || 0)));
    });
    widget.bind(window.SC.Widget.Events.FINISH, () => {
      localStorage.setItem(storage.position, '0');
      if (tracks.length > 1) {
        trackIndex = (trackIndex + 1) % tracks.length;
        loadTrack(true);
      } else {
        widget.seekTo(0);
        if (desiredPlaying) widget.play();
      }
    });

    toggle.addEventListener('click', () => {
      if (root.dataset.state === 'playing') requestPause();
      else requestPlay();
    });
    next.addEventListener('click', () => {
      trackIndex = (trackIndex + 1) % tracks.length;
      localStorage.setItem(storage.position, '0');
      loadTrack(desiredPlaying);
    });
    volume.addEventListener('input', () => {
      localStorage.setItem(storage.volume, volume.value);
      if (ready) widget.setVolume(Number(volume.value));
    });
    collapse.addEventListener('click', () => {
      root.dataset.collapsed = 'true';
      localStorage.setItem(storage.collapsed, 'true');
    });
    expand.addEventListener('click', () => {
      root.dataset.collapsed = 'false';
      localStorage.setItem(storage.collapsed, 'false');
    });
    window.addEventListener('portfolio:enter-requested', requestPlay);
    window.addEventListener('pagehide', () => {
      if (!ready) return;
      widget.getPosition((position) => localStorage.setItem(storage.position, String(Math.round(position || 0))));
    });
  })();
</script>

<style>
  .music-player {
    --player-accent: #d8ff55;
    position: fixed;
    z-index: 80;
    right: 22px;
    bottom: 22px;
    width: min(380px, calc(100vw - 32px));
    color: #f4f3ef;
    filter: drop-shadow(0 24px 42px rgba(0, 0, 0, .48));
    transition: opacity .25s ease, transform .25s ease;
  }
  :global(html.entry-is-loading) .music-player { opacity: 0; pointer-events: none; transform: translateY(14px); }
  .music-player__panel {
    min-height: 104px;
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    padding: 10px 10px 10px 11px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(27,29,31,.94), rgba(8,9,11,.96));
    backdrop-filter: blur(20px) saturate(1.15);
  }
  .music-player__artwork { position: relative; width: 82px; aspect-ratio: 1; overflow: hidden; border-radius: 12px; background: #17191d; }
  .music-player__artwork img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .music-player__equalizer { position: absolute; left: 8px; bottom: 8px; height: 20px; display: flex; align-items: end; gap: 2px; padding: 4px; border-radius: 6px; background: rgba(2,3,5,.72); }
  .music-player__equalizer i { display: block; width: 2px; height: 5px; background: var(--player-accent); transform-origin: bottom; }
  .music-player[data-state='playing'] .music-player__equalizer i { animation: player-eq .72s ease-in-out infinite alternate; }
  .music-player[data-state='playing'] .music-player__equalizer i:nth-child(2) { animation-delay: -.44s; }
  .music-player[data-state='playing'] .music-player__equalizer i:nth-child(3) { animation-delay: -.21s; }
  .music-player__copy { min-width: 0; align-self: center; }
  .music-player__copy p { margin: 0 0 7px; color: #84878d; font: 650 8px/1 'JetBrains Mono', monospace; letter-spacing: .13em; }
  .music-player__copy a { display: block; min-width: 0; }
  .music-player__copy strong, .music-player__copy span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .music-player__copy strong { color: #f4f3ef; font: 700 13px/1.22 'Space Grotesk', sans-serif; }
  .music-player__copy a > span { margin-top: 5px; color: #9b9da2; font-size: 11px; }
  .music-player__copy a:hover strong { color: var(--player-accent); }
  .music-player__controls { align-self: stretch; display: grid; grid-template-columns: 38px 28px; grid-template-rows: 28px 1fr; align-items: center; gap: 4px; }
  .music-player__controls button, .music-player__mini { border: 0; color: #f4f3ef; cursor: pointer; }
  .music-player__controls button { background: transparent; }
  .music-player__controls [data-player-toggle] { grid-row: 2; width: 38px; height: 38px; border-radius: 50%; color: #090a0b; background: var(--player-accent); font-size: 11px; }
  .music-player__controls [data-player-next] { grid-column: 2; grid-row: 2; color: #b8bac0; font-size: 28px; line-height: 1; }
  .music-player__controls [data-player-next]:disabled { opacity: .22; cursor: default; }
  .music-player__controls [data-player-collapse] { grid-column: 2; grid-row: 1; color: #7e8188; font-size: 17px; }
  .music-player__pause { display: none; font-size: 10px; letter-spacing: -2px; transform: translateX(-1px); }
  .music-player[data-state='playing'] .music-player__pause { display: inline; }
  .music-player[data-state='playing'] .music-player__play { display: none; }
  .music-player__volume { grid-column: 2 / 4; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 7px; margin: -8px 5px 2px 0; color: #686b71; font: 650 7px/1 'JetBrains Mono', monospace; letter-spacing: .12em; }
  .music-player__volume input { width: 100%; height: 2px; accent-color: var(--player-accent); cursor: pointer; }
  .music-player__mini { display: none; width: 54px; height: 54px; margin-left: auto; border: 1px solid rgba(255,255,255,.15); border-radius: 50%; background: rgba(12,13,15,.92); backdrop-filter: blur(18px); }
  .music-player__mini span { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: #090a0b; background: var(--player-accent); font-size: 17px; }
  .music-player[data-collapsed='true'] { width: 54px; }
  .music-player[data-collapsed='true'] .music-player__panel { display: none; }
  .music-player[data-collapsed='true'] .music-player__mini { display: block; }
  .music-player__engine { position: fixed; left: -10000px; top: -10000px; width: 166px; height: 166px; opacity: 0; pointer-events: none; }
  @keyframes player-eq { from { transform: scaleY(.55); } to { transform: scaleY(2.7); } }
  @media (max-width: 620px) {
    .music-player { right: 14px; bottom: 14px; width: min(340px, calc(100vw - 28px)); }
    .music-player__panel { grid-template-columns: 68px minmax(0, 1fr) auto; min-height: 90px; }
    .music-player__artwork { width: 68px; }
    .music-player__copy strong { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .music-player, .music-player__equalizer i { animation: none !important; transition: none !important; }
  }
</style>
