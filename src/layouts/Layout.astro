---
import '../styles/global.css'
import { base, withBase } from '../utils/paths'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Yaohan — Field Archive',
  description = 'A personal cybersecurity archive for labs, CTF writeups, forensics notes, achievements, and learning documentation.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const socialImage = new URL(withBase('og.png'), Astro.site ?? Astro.url.origin)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>

    <script
      is:inline
      src="https://identity.netlify.com/v1/netlify-identity-widget.js"
    ></script>
  </head>

  <body>
    <slot />

    <script is:inline define:vars={{ base }}>
      const assetBase = base.endsWith('/') ? base : `${base}/`;
      const resolveAsset = (value) => {
        if (!value || /^(https?:|mailto:|tel:|#)/.test(value)) return value;
        const clean = value.replace(/^\/portfolio(?=\/|$)/, '').replace(/^\/+/, '');
        return `${assetBase}${clean}`;
      };
      document.querySelectorAll('img[src], source[src], video[poster]').forEach((node) => {
        const attribute = node.hasAttribute('poster') ? 'poster' : 'src';
        node.setAttribute(attribute, resolveAsset(node.getAttribute(attribute)));
      });
      document.querySelectorAll('a[href^="/uploads"], a[href^="/portfolio/uploads"]').forEach((node) => {
        node.setAttribute('href', resolveAsset(node.getAttribute('href')));
      });

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.animate(
            [{ opacity: .18, transform: 'translateY(24px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 620, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'both' }
          );
          observer.unobserve(entry.target);
        }), { threshold: .08 });
        document.querySelectorAll('.record-card,.lab-sheet,.award-record,.journal-entry,.ledger-row,.skill-record').forEach((node) => observer.observe(node));
      }
      if (!reduceMotion && matchMedia('(pointer:fine)').matches) {
        document.querySelectorAll('.record-card,.lab-sheet,.skill-record,.game-console').forEach((surface) => {
          surface.addEventListener('pointermove', (event) => {
            const rect = surface.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width;
            const y = (event.clientY - rect.top) / rect.height;
            surface.style.setProperty('--rx', `${(0.5-y)*5}deg`);
            surface.style.setProperty('--ry', `${(x-0.5)*7}deg`);
            surface.style.setProperty('--mx', `${x*100}%`);
            surface.style.setProperty('--my', `${y*100}%`);
          });
          surface.addEventListener('pointerleave', () => {
            surface.style.setProperty('--rx', '0deg');
            surface.style.setProperty('--ry', '0deg');
          });
        });
        const spatialHero = document.querySelector('.hero');
        spatialHero?.addEventListener('pointermove', (event) => {
          const rect = spatialHero.getBoundingClientRect();
          spatialHero.style.setProperty('--hero-x', String((event.clientX-rect.left)/rect.width-.5));
          spatialHero.style.setProperty('--hero-y', String((event.clientY-rect.top)/rect.height-.5));
        });
      }
    </script>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const hash = window.location.hash || "";

        if (!window.netlifyIdentity) {
          return;
        }

        window.netlifyIdentity.on("init", (user) => {
          const isIdentityAction =
            hash.includes("invite_token") ||
            hash.includes("confirmation_token") ||
            hash.includes("recovery_token") ||
            hash.includes("email_change_token");

          if (isIdentityAction) {
            window.netlifyIdentity.open();
          }

          if (!user) {
            window.netlifyIdentity.on("login", () => {
              window.location.href = "/admin/";
            });
          }
        });

        window.netlifyIdentity.init();
      });
    </script>
  </body>
</html>
