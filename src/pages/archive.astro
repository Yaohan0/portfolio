---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'
const items=(await getCollection('archive')).sort((a,b)=>a.data.order-b.data.order)
const tags=[...new Set(items.flatMap(item=>item.data.tags))].slice(0,8)
const groups=['Old coursework','References','Experiments','Media','Miscellaneous']
const groupFor=(item) => {
  const haystack=`${item.data.title} ${item.data.type} ${item.data.tags.join(' ')}`.toLowerCase()
  if(/class note|course|ecomm|ennk|ehip|fds|sads/.test(haystack)) return 'Old coursework'
  if(/reference|guide|handbook|framework|article|research/.test(haystack)) return 'References'
  if(/experiment|prototype|draft|test/.test(haystack)) return 'Experiments'
  if(/image|photo|video|audio|media|screenshot/.test(haystack)) return 'Media'
  return 'Miscellaneous'
}
const groupedItems=items.map(item=>({item,group:groupFor(item)}))
---
<Layout title="Archive — Yaohan"><main class="section-page archive-page"><Navbar current="Archive" />
  <header class="archive-hero"><pre>████████████████████████████████\n█ ARCHIVAL SYSTEM v2.6 ONLINE █\n████████████████████████████████</pre><h1>Archive</h1><p>&gt; OLDER EXPORTS, REFERENCES &amp; EXPERIMENTS — {items.length} ENTRIES INDEXED<span>█</span></p></header>
  <p class="archive-purpose">Archive is long-term storage for material outside active class notes. Current lesson files belong in Notes; completed challenge solutions belong in Writeups.</p>
  <section class="archive-console"><label class="console-bar"><span>SEARCH://</span><input id="archive-search" type="search" placeholder="query..." aria-label="Search archive" /></label><div class="archive-groups"><button class="active" type="button" data-archive-group="all">All <span>{items.length}</span></button>{groups.map(group=><button type="button" data-archive-group={group.toLowerCase()}>{group} <span>{groupedItems.filter(item=>item.group===group).length}</span></button>)}</div>{tags.length>0&&<div class="archive-tags">{tags.map(tag=><button type="button" data-archive-tag={tag}>[{tag}]</button>)}</div>}
    <div class="archive-table"><div class="archive-row archive-head"><span>FILENAME</span><span>TYPE</span><span>DATE</span><span>STATUS</span><span></span></div>
    {groupedItems.map(({item,group})=><a class="archive-row" data-archive-row data-group={group.toLowerCase()} data-search={`${item.data.title} ${item.data.summary} ${item.data.type} ${group} ${item.data.tags.join(' ')}`.toLowerCase()} href={withBase(`archive/${item.data.slug}`)}><span>{item.data.title}<small>{item.data.summary}</small></span><span>{group}</span><span>{item.data.date}</span><span>{item.data.status}</span><b>↗</b></a>)}</div><p class="console-end">&gt; <span id="archive-count">{items.length}</span>/{items.length} ENTRIES DISPLAYED</p></section>
  <script is:inline>
    const search = document.getElementById('archive-search'); const rows = [...document.querySelectorAll('[data-archive-row]')]; const count = document.getElementById('archive-count'); const groupButtons=[...document.querySelectorAll('[data-archive-group]')]; let activeGroup='all';
    const filter = () => { const query = search.value.trim().toLowerCase(); let shown=0; rows.forEach(row=>{const visible=(activeGroup==='all'||row.dataset.group===activeGroup)&&row.dataset.search.includes(query);row.hidden=!visible;if(visible)shown++});count.textContent=shown; };
    search?.addEventListener('input',filter); groupButtons.forEach(button=>button.addEventListener('click',()=>{activeGroup=button.dataset.archiveGroup;groupButtons.forEach(item=>item.classList.toggle('active',item===button));filter()})); document.querySelectorAll('[data-archive-tag]').forEach(button=>button.addEventListener('click',()=>{search.value=button.dataset.archiveTag;filter()}));
  </script>
</main></Layout>
