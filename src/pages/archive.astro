---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'
const items=(await getCollection('archive')).sort((a,b)=>a.data.order-b.data.order)
const tags=[...new Set(items.flatMap(item=>item.data.tags))].slice(0,8)
---
<Layout title="Archive — Yaohan"><main class="section-page archive-page"><Navbar current="Archive" />
  <header class="archive-hero"><pre>████████████████████████████████\n█ ARCHIVAL SYSTEM v2.6 ONLINE █\n████████████████████████████████</pre><h1>Archive</h1><p>&gt; DOCUMENTS &amp; FILES — {items.length} ENTRIES INDEXED<span>█</span></p></header>
  <section class="archive-console"><label class="console-bar"><span>SEARCH://</span><input id="archive-search" type="search" placeholder="query..." aria-label="Search archive" /></label>{tags.length>0&&<div class="archive-tags">{tags.map(tag=><button type="button" data-archive-tag={tag}>[{tag}]</button>)}</div>}
    <div class="archive-table"><div class="archive-row archive-head"><span>FILENAME</span><span>TYPE</span><span>DATE</span><span>STATUS</span><span></span></div>
    {items.map(item=><a class="archive-row" data-search={`${item.data.title} ${item.data.summary} ${item.data.type} ${item.data.tags.join(' ')}`.toLowerCase()} href={withBase(`archive/${item.data.slug}`)}><span>{item.data.title}<small>{item.data.summary}</small></span><span>{item.data.type}</span><span>{item.data.date}</span><span>{item.data.status}</span><b>↗</b></a>)}</div><p class="console-end">&gt; <span id="archive-count">{items.length}</span>/{items.length} ENTRIES DISPLAYED</p></section>
  <script is:inline>
    const search = document.getElementById('archive-search'); const rows = [...document.querySelectorAll('.archive-row[data-search]')]; const count = document.getElementById('archive-count');
    const filter = value => { const query = value.trim().toLowerCase(); let shown=0; rows.forEach(row=>{const visible=row.dataset.search.includes(query);row.hidden=!visible;if(visible)shown++});count.textContent=shown; };
    search?.addEventListener('input',()=>filter(search.value)); document.querySelectorAll('[data-archive-tag]').forEach(button=>button.addEventListener('click',()=>{search.value=button.dataset.archiveTag;filter(search.value)}));
  </script>
</main></Layout>
