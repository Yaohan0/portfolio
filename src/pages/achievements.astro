---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'
const achievements=(await getCollection('achievements')).sort((a,b)=>a.data.order-b.data.order)
---
<Layout title="Achievements — Yaohan"><main class="section-page achievements-page"><Navbar current="Achievements" />
  <header class="collection-hero award-hero"><p class="collection-kicker">◆ HALL OF RECORD ◆</p><h1>Achieve<br/><em>ments</em></h1><div class="award-intro"><p>Milestones, recognition, and proof of progress—not a trophy shelf, but a record of work completed and standards reached.</p><strong>{String(achievements.length).padStart(2,'0')}</strong></div></header>
  <section class="award-list">{achievements.map((item,index)=><a href={withBase(`achievements/${item.data.slug}`)} class="award-record">
    <div class="award-seal"><span>{String(index+1).padStart(2,'0')}</span></div>
    <div class="award-date">{item.data.date}<span>{item.data.type}</span></div>
    <div class="award-copy"><p>RECORD / {item.data.status}</p><h2>{item.data.title}</h2><p>{item.data.description}</p></div>
    {item.data.cover ? <img src={withBase(item.data.cover)} alt={item.data.title} loading="lazy" /> : <div class="award-monogram">YH</div>}
    <span class="award-open">VIEW RECORD ↗</span></a>)}</section>
</main></Layout>
