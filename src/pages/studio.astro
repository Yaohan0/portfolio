---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yaohan Studio</title>
    <style is:global>
      :root{--studio-acid:#d8ff55;--studio-bg:#0a0a0f;--studio-panel:#111118;--studio-line:#2a2a34;--studio-muted:#858590}*{box-sizing:border-box}.studio-body{background:var(--studio-bg);color:#f4f2eb}.studio-shell{min-height:100vh;display:grid;grid-template-columns:290px minmax(0,1fr);background-image:radial-gradient(circle at 80% 0,rgba(216,255,85,.055),transparent 28%)}.studio-aside{position:sticky;top:0;height:100vh;overflow:auto;border-right:1px solid var(--studio-line);padding:22px;background:#0c0c12}.studio-brand{display:flex;align-items:center;gap:12px;margin-bottom:24px}.studio-brand b{display:grid;place-items:center;width:42px;height:42px;border-radius:10px;background:var(--studio-acid);color:#0a0a0f;font-weight:900}.studio-brand small{display:block;color:#656570;font:600 9px "JetBrains Mono",monospace;letter-spacing:.14em}.studio-brand strong{display:block;margin-top:4px}.studio-search{width:100%;margin-bottom:12px;border:1px solid var(--studio-line);border-radius:9px;background:#08080d;padding:11px 12px;color:#eee;font:500 11px "JetBrains Mono",monospace;outline:none}.studio-search:focus{border-color:#78952b}.studio-workspace{display:grid;grid-template-columns:minmax(0,1fr) 390px;min-width:0}.studio-editor{min-width:0;padding:34px 42px 100px}.studio-editor-header{position:sticky;z-index:15;top:0;margin:-34px -42px 32px;padding:24px 42px 20px;background:rgba(10,10,15,.9);border-bottom:1px solid var(--studio-line);backdrop-filter:blur(16px)}.studio-actions{display:flex;gap:8px;align-items:center}.studio-status{border:1px solid var(--studio-line);border-radius:999px;padding:9px 12px;color:#73737f;font:700 9px "JetBrains Mono",monospace;letter-spacing:.12em}.studio-status.dirty{color:#f1c75b;border-color:#7c642b}.studio-status.publishing{color:#8ddcff;border-color:#366475;animation:studio-pulse 1s ease-in-out infinite alternate}.studio-status.local{color:#ff9e72;border-color:#784a36}.studio-status.saved{color:var(--studio-acid);border-color:#60752e}.studio-action{border:1px solid var(--studio-line);border-radius:999px;background:transparent;color:#9999a4;padding:11px 14px;font:700 9px "JetBrains Mono",monospace;letter-spacing:.1em;text-transform:uppercase}.studio-action:hover{border-color:#6f8732;color:var(--studio-acid)}.studio-action.danger:hover{border-color:#8b3b48;color:#ff7182}.block-toolbar{position:sticky;z-index:10;top:104px;padding:12px;border:1px solid var(--studio-line);border-radius:12px;background:rgba(17,17,24,.94);backdrop-filter:blur(12px)}.block-card{border-radius:8px!important;background:#101017!important}.block-card:focus-within{border-color:#778c3a!important;box-shadow:0 0 0 3px rgba(216,255,85,.055)}.studio-preview{position:sticky;top:0;height:100vh;overflow:auto;border-left:1px solid var(--studio-line);background:#0c0c12;padding:28px}.studio-preview.is-hidden{display:none}.studio-workspace.preview-hidden{grid-template-columns:1fr}.studio-empty{padding:28px 12px;color:#555561;text-align:center;font:600 10px "JetBrains Mono",monospace}.doc-button.active{border-color:#6d8532!important;background:rgba(216,255,85,.07)!important}.collection-button{border-radius:8px!important}.studio-kbd{display:inline-block;border:1px solid #3a3a44;border-bottom-width:2px;border-radius:4px;padding:2px 5px;font-size:8px;color:#757580}@keyframes studio-pulse{to{opacity:.55}}@media(max-width:1100px){.studio-workspace{grid-template-columns:1fr}.studio-preview{position:relative;height:auto;border-left:0;border-top:1px solid var(--studio-line)}.studio-editor-header{position:relative;top:auto}.studio-shell{grid-template-columns:240px 1fr}}@media(max-width:760px){.studio-shell{display:block}.studio-aside{position:relative;width:auto;height:auto;border-right:0;border-bottom:1px solid var(--studio-line)}.studio-workspace{display:block}.studio-editor{padding:24px 18px}.studio-editor-header{margin:-24px -18px 24px;padding:20px 18px}.studio-actions{flex-wrap:wrap}}
      /* Surface editor */
      .studio-aside{overflow-x:hidden}.collection-button{min-width:0;padding-inline:8px!important;overflow:hidden;text-overflow:ellipsis;font-size:9px!important;letter-spacing:.075em!important}
      .studio-workspace{grid-template-rows:58px minmax(0,1fr);grid-template-areas:"topbar topbar" "editor preview"}
      .studio-topbar{grid-area:topbar;position:sticky;z-index:30;top:0;min-width:0;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 14px;border-bottom:1px solid var(--studio-line);background:rgba(12,12,18,.94);backdrop-filter:blur(18px)}
      .studio-mode-switch,.studio-surface-tools,.studio-device-tools{display:flex;align-items:center;gap:5px}.studio-tool,.studio-mode{min-height:36px;padding:0 11px;border:1px solid transparent;border-radius:8px;background:transparent;color:#858590;font:700 9px "JetBrains Mono",monospace;letter-spacing:.08em;text-transform:uppercase;transition:.18s}.studio-tool:hover,.studio-mode:hover{border-color:#34343f;color:#e9e6de}.studio-mode.active{border-color:#596d2a;background:rgba(216,255,85,.08);color:var(--studio-acid)}.studio-tool.is-active{background:#e8e4da;color:#111}.studio-tool-separator{width:1px;height:24px;margin:0 3px;background:#2b2b35}.studio-selection{min-width:120px;color:#5f5f6c;font:600 8px "JetBrains Mono",monospace;text-align:right;text-transform:uppercase;letter-spacing:.1em}
      .studio-editor{grid-area:editor}.studio-preview{grid-area:preview}.studio-file-browser{grid-area:files;display:none;min-width:0;padding:32px 38px 80px;background:#0d0d12}
      .studio-workspace.mode-surface{grid-template-columns:minmax(0,1fr) 360px;grid-template-areas:"topbar topbar" "preview editor"}.studio-workspace.mode-surface .studio-editor{height:calc(100vh - 58px);overflow:auto;padding:24px 22px 80px;border-left:1px solid var(--studio-line);background:#0c0c12}.studio-workspace.mode-surface .studio-editor-header{position:relative;top:auto;margin:-24px -22px 22px;padding:18px 22px}.studio-workspace.mode-surface .studio-editor-header h2{font-size:1.25rem}.studio-workspace.mode-surface .studio-actions{margin-top:12px;align-items:flex-start;flex-wrap:wrap}.studio-workspace.mode-surface #open-page,.studio-workspace.mode-surface #duplicate-doc,.studio-workspace.mode-surface #delete-doc,.studio-workspace.mode-surface #toggle-preview{padding:9px 11px;font-size:8px}.studio-workspace.mode-surface #save-doc{padding:10px 16px}.studio-workspace.mode-surface .block-toolbar{position:relative;top:auto}.studio-workspace.mode-surface .studio-preview{position:relative;top:auto;height:calc(100vh - 58px);overflow:auto;padding:58px;background-color:#18181e;background-image:linear-gradient(45deg,#1c1c23 25%,transparent 25%),linear-gradient(-45deg,#1c1c23 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#1c1c23 75%),linear-gradient(-45deg,transparent 75%,#1c1c23 75%);background-size:24px 24px;background-position:0 0,0 12px,12px -12px,-12px 0}.studio-workspace.mode-surface .studio-preview>p:first-child{display:none}.studio-workspace.mode-surface #preview{--surface-zoom:1;width:min(100%,1180px);min-height:720px;margin:0 auto;padding:64px 70px;border:1px solid #34343c;border-radius:3px;background:#0d0d0c;color:#eae6dc;box-shadow:0 32px 90px rgba(0,0,0,.42);transform:scale(var(--surface-zoom));transform-origin:top center;transition:width .25s,transform .2s}.studio-workspace.mode-surface #preview.surface-tablet{width:768px}.studio-workspace.mode-surface #preview.surface-mobile{width:390px;padding:42px 28px}.studio-workspace.mode-surface .studio-kbd{display:none}
      #preview [contenteditable="true"]{outline:0;border-radius:5px;transition:box-shadow .15s,background .15s}#preview [contenteditable="true"]:hover{background:rgba(216,255,85,.035);box-shadow:0 0 0 7px rgba(216,255,85,.035)}#preview [contenteditable="true"]:focus,#preview .surface-selected{background:rgba(216,255,85,.055);box-shadow:0 0 0 2px var(--studio-acid),0 0 0 8px rgba(216,255,85,.055)}#preview .surface-label{margin-bottom:22px;color:#77736c;font:700 9px "JetBrains Mono",monospace;letter-spacing:.16em;text-transform:uppercase}#preview .surface-title{margin:0;font:400 clamp(4rem,8vw,8rem)/.82 Georgia,serif;letter-spacing:-.065em}#preview .surface-summary{max-width:760px;margin:24px 0 42px;color:#a39f96;font-size:1.02rem;line-height:1.75}#preview .surface-cover{width:100%;max-height:520px;margin:0 0 42px;object-fit:cover;border:1px solid #34342f}#preview .surface-block{position:relative;margin:24px 0;padding:3px}#preview .surface-block::before{content:attr(data-block-label);position:absolute;right:calc(100% + 18px);top:8px;color:#55524d;font:700 7px "JetBrains Mono",monospace;letter-spacing:.1em;text-transform:uppercase;opacity:0;transition:.15s}#preview .surface-block:hover::before,#preview .surface-selected::before{opacity:1}#preview .surface-block h2{font:500 2.5rem/1.05 Georgia,serif}#preview .surface-block h3{font-size:1.45rem}#preview .surface-block p{color:#aaa69d;font-size:1rem;line-height:1.8}#preview .surface-file{display:flex;align-items:center;justify-content:space-between;padding:18px;border:1px solid #34343b;color:var(--studio-acid)}
      .studio-workspace.mode-form{grid-template-columns:minmax(0,1fr) 390px;grid-template-areas:"topbar topbar" "editor preview"}.studio-workspace.mode-form .studio-file-browser{display:none}
      .studio-workspace.mode-files{grid-template-columns:1fr;grid-template-areas:"topbar" "files"}.studio-workspace.mode-files .studio-editor,.studio-workspace.mode-files .studio-preview{display:none}.studio-workspace.mode-files .studio-file-browser{display:block}
      .studio-bridge{grid-column:1/-1;grid-row:2;min-height:calc(100vh - 58px);padding:60px;display:grid;place-items:center;background:radial-gradient(circle at 50% 20%,rgba(216,255,85,.07),transparent 32%),#0d0d12}.studio-bridge[hidden]{display:none}.studio-bridge-card{width:min(620px,100%);padding:44px;border:1px solid #30303a;border-radius:18px;background:#121218;box-shadow:0 36px 100px rgba(0,0,0,.38)}.studio-bridge-card small{color:var(--studio-acid);font:700 9px "JetBrains Mono",monospace;letter-spacing:.15em}.studio-bridge-card h1{margin:18px 0;font-size:2.4rem;line-height:1.05}.studio-bridge-card p{color:#9995a0;line-height:1.75}.studio-bridge-card a{display:inline-block;margin-top:28px;padding:13px 17px;border-radius:9px;background:var(--studio-acid);color:#111;font:800 10px "JetBrains Mono",monospace;letter-spacing:.08em;text-transform:uppercase}.studio-workspace.studio-hosted .studio-editor,.studio-workspace.studio-hosted .studio-preview,.studio-workspace.studio-hosted .studio-file-browser{display:none!important}
      .drive-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:30px}.drive-head small{color:#747480;font:700 9px "JetBrains Mono",monospace;letter-spacing:.15em}.drive-head h2{margin-top:8px;font-size:2.2rem}.drive-actions{display:flex;flex-wrap:wrap;gap:8px}.drive-action{padding:11px 14px;border:1px solid #34343f;border-radius:9px;background:#13131a;color:#cac7bf;font:700 9px "JetBrains Mono",monospace;letter-spacing:.08em;text-transform:uppercase}.drive-action:hover{border-color:#646471;color:#fff}.drive-action.primary{border-color:#758f35;background:var(--studio-acid);color:#111}.drive-action[hidden]{display:none}.drive-layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:28px}.drive-subjects{display:grid;align-content:start;gap:7px}.drive-subject{padding:12px 13px;border:1px solid transparent;border-radius:9px;background:transparent;color:#7d7d88;text-align:left;font:700 10px "JetBrains Mono",monospace}.drive-subject.active,.drive-subject:hover{border-color:#34343f;background:#15151c;color:#efede6}.drive-subject span{display:block;margin-top:4px;color:#555560;font-size:8px}.drive-drop{min-height:520px;padding:24px;border:1px solid #292933;border-radius:14px;background:#101017;transition:.2s}.drive-drop.is-dragging{border-color:var(--studio-acid);background:rgba(216,255,85,.035)}.drive-path{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;color:#77737d;font:700 9px "JetBrains Mono",monospace;letter-spacing:.12em;text-transform:uppercase}.drive-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}.drive-card{position:relative;min-height:164px;padding:17px;border:1px solid #2c2c36;border-radius:12px;background:#15151c;color:#e8e5dd;text-align:left;transition:.18s;cursor:default}.drive-card:hover,.drive-card.is-selected{border-color:#5a5a66;transform:translateY(-2px)}.drive-card.is-selected{box-shadow:0 0 0 1px rgba(216,255,85,.28)}.drive-open{width:100%;height:100%;border:0;background:transparent;color:inherit;text-align:left}.drive-card-icon{width:42px;height:34px;margin-bottom:27px;border:1px solid #474751;border-radius:4px 8px 5px 5px;background:#1d1d25;display:grid;place-items:center;color:var(--studio-acid);font:700 9px "JetBrains Mono",monospace}.drive-folder-icon{position:relative;width:55px;height:37px;margin:8px 0 30px;border:1px solid #d1a63a;border-radius:5px;background:linear-gradient(145deg,#f2c652,#c99a28);box-shadow:0 10px 20px rgba(0,0,0,.2)}.drive-folder-icon::before{content:"";position:absolute;left:3px;top:-8px;width:24px;height:10px;border:1px solid #d1a63a;border-bottom:0;border-radius:5px 5px 0 0;background:#e5b943}.drive-card h3{font-size:.94rem;line-height:1.35}.drive-card p{margin-top:7px;color:#6f6f7b;font:600 8px "JetBrains Mono",monospace;text-transform:uppercase}.drive-card-actions{position:absolute;right:10px;top:10px;width:28px;height:28px;border:1px solid #33333d;border-radius:7px;background:#111117;color:#8b8b95;display:grid;place-items:center}.drive-card-actions:hover{color:var(--studio-acid);border-color:#667d32}.drive-card-hint{position:absolute;right:16px;bottom:13px;color:#50505c!important}.drive-media-thumb{width:100%;height:88px;margin-bottom:18px;border-radius:8px;object-fit:cover;background:#0d0d12}.drive-attachments{grid-column:1/-1;margin-top:20px;padding-top:18px;border-top:1px solid #292933}.drive-attachments[hidden]{display:none}.drive-attachments h3{margin-bottom:12px;color:#8d8993;font:700 9px "JetBrains Mono",monospace;letter-spacing:.12em;text-transform:uppercase}.drive-file-row{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 12px;border-bottom:1px solid #24242d;color:#bdb9b1}.drive-file-row b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.84rem}.drive-file-row span{color:#63636e;font:600 8px "JetBrains Mono",monospace}.drive-file-row a{color:#bdb9b1}.drive-file-row button{border:0;background:transparent;color:#d2767c;font-size:.75rem}.drive-empty-folder{grid-column:1/-1;min-height:240px;display:grid;place-items:center;text-align:center;color:#64646f;font:700 9px "JetBrains Mono",monospace;letter-spacing:.12em;text-transform:uppercase}.drive-empty-folder b{display:block;margin-bottom:10px;color:#aaa6ad;font-size:11px}
      @media(max-width:1450px){.studio-selection,.studio-surface-tools [data-surface-format],.studio-tool-separator{display:none}.studio-surface-tools{min-width:0}}
      @media(max-width:1200px){.studio-surface-tools{display:none}.studio-workspace.mode-surface{grid-template-columns:minmax(0,1fr) 320px}.studio-workspace.mode-surface .studio-preview{padding:40px 28px}.studio-workspace.mode-surface #preview{padding:52px 44px}}
      @media(max-width:900px){.studio-topbar{position:relative;flex-wrap:wrap;height:auto}.studio-device-tools{display:none}.studio-workspace,.studio-workspace.mode-surface,.studio-workspace.mode-form{display:block}.studio-workspace .studio-topbar{display:flex}.studio-workspace.mode-surface .studio-preview{height:auto;min-height:700px}.studio-workspace.mode-surface .studio-editor{height:auto;border-left:0;border-top:1px solid var(--studio-line)}.drive-layout{grid-template-columns:1fr}.drive-subjects{grid-template-columns:repeat(5,1fr)}.studio-file-browser{padding:24px 18px}}
      @media(max-width:600px){.studio-mode{padding-inline:8px;font-size:8px}.studio-selection{display:none}.studio-workspace.mode-surface .studio-preview{padding:28px 12px}.studio-workspace.mode-surface #preview{width:100%!important;min-height:620px;padding:34px 22px}.drive-head{align-items:flex-start;flex-direction:column}.drive-subjects{grid-template-columns:repeat(2,1fr)}.drive-grid{grid-template-columns:1fr 1fr}}
    </style>
  </head>

  <body class="studio-body min-h-screen bg-[#090909] text-[#f3efe4]">
    <main class="studio-shell">
      <aside class="studio-aside">
        <div class="studio-brand"><b>YH</b><div><small>CONTENT SYSTEM</small><strong>Yaohan Studio</strong></div></div>
        <div class="mb-8">
          <p class="font-mono text-xs uppercase tracking-[0.35em] text-[#c9ff5f]">Local Editor</p>

          <p class="mt-3 text-sm leading-6 text-[#a9a196]">
            Edit your profile, hobbies, notes, projects and every portfolio collection.
          </p>
        </div>

        <div id="collection-buttons" class="mb-5 grid grid-cols-2 gap-2"></div>

        <button
          id="new-doc"
          class="mb-5 w-full rounded-xl border border-white/10 bg-[#111111] px-4 py-3 text-left font-mono text-xs uppercase tracking-widest text-[#c9ff5f] transition hover:border-[#c9ff5f]/60"
        >
          + New document
        </button>

        <input id="doc-search" class="studio-search" type="search" placeholder="Search documents..." aria-label="Search documents" />
        <div id="doc-list" class="space-y-2"></div>
      </aside>

      <section id="studio-workspace" class="studio-workspace mode-surface">
        <div class="studio-topbar">
          <div class="studio-mode-switch" aria-label="Studio view">
            <button class="studio-mode active" data-mode="surface" type="button">Surface</button>
            <button class="studio-mode" data-mode="form" type="button">Details</button>
            <button class="studio-mode" data-mode="files" type="button">Notes Library</button>
          </div>
          <div class="studio-surface-tools" aria-label="Insert content">
            <button class="studio-tool" data-surface-add="heading" type="button">+ Heading</button>
            <button class="studio-tool" data-surface-add="paragraph" type="button">+ Text</button>
            <button class="studio-tool" data-surface-add="image" type="button">+ Image</button>
            <button class="studio-tool" data-surface-add="file" type="button">+ File</button>
            <button class="studio-tool" data-surface-add="callout" type="button">+ Callout</button>
            <span class="studio-tool-separator"></span>
            <button class="studio-tool" data-surface-format="heading" type="button">H1</button>
            <button class="studio-tool" data-surface-format="subheading" type="button">H2</button>
            <button class="studio-tool" data-surface-format="paragraph" type="button">Body</button>
          </div>
          <div class="studio-device-tools">
            <button class="studio-tool is-active" data-width="desktop" type="button">Desktop</button>
            <button class="studio-tool" data-width="tablet" type="button">Tablet</button>
            <button class="studio-tool" data-width="mobile" type="button">Mobile</button>
            <span id="surface-selection" class="studio-selection">Select a block</span>
          </div>
        </div>
        <section id="studio-bridge" class="studio-bridge" hidden>
          <div class="studio-bridge-card">
            <small>LOCAL WORKSPACE REQUIRED</small>
            <h1>Edit locally.<br/>Publish everywhere.</h1>
            <p>Studio needs direct access to your portfolio files, so editing runs from your computer. The interface and content are the same; pressing Save still updates localhost and publishes the live website.</p>
            <a href="http://localhost:4321/studio">Open Local Studio ↗</a>
          </div>
        </section>
        <div class="studio-editor">
          <div class="studio-editor-header mb-8 flex flex-wrap items-center justify-between gap-4">
            <div>
              <p id="current-path" class="font-mono text-xs uppercase tracking-[0.25em] text-[#6f6a63]">
                No document selected
              </p>

              <h2 id="editor-title" class="mt-3 text-3xl font-bold">
                Editor
              </h2>
            </div>

            <div class="studio-actions">
              <span id="save-status" class="studio-status saved">SAVED</span>
              <a
                id="open-page"
                href="#"
                target="_blank"
                class="rounded-full border border-white/10 px-6 py-3 font-mono text-xs font-bold uppercase tracking-widest text-[#a9a196] transition hover:border-[#c9ff5f]/60 hover:text-[#c9ff5f]"
              >
                Open page
              </a>

              <button
                id="save-doc"
                class="rounded-full bg-[#c9ff5f] px-6 py-3 font-mono text-xs font-black uppercase tracking-widest text-black transition hover:scale-105"
              >
                Save
              </button>
              <button id="duplicate-doc" class="studio-action" type="button">Duplicate</button>
              <button id="delete-doc" class="studio-action danger" type="button">Delete</button>
              <button id="toggle-preview" class="studio-action" type="button">Preview</button>
            </div>
          </div>

          <div class="mb-8 grid gap-4 md:grid-cols-2">
            <label class="block">
              <span id="title-label" class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                Title
              </span>
              <input
                id="field-title"
                class="mt-2 w-full rounded-xl border border-white/10 bg-[#111111] px-4 py-3 text-[#f3efe4] outline-none focus:border-[#c9ff5f]/60"
              />
            </label>

            <label class="block">
              <span class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                Slug
              </span>
              <input
                id="field-slug"
                class="mt-2 w-full rounded-xl border border-white/10 bg-[#111111] px-4 py-3 font-mono text-[#f3efe4] outline-none focus:border-[#c9ff5f]/60"
              />
            </label>

            <label id="summary-wrapper" class="block md:col-span-2">
              <span id="summary-label" class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                Summary
              </span>
              <textarea
                id="field-summary"
                rows="3"
                class="mt-2 w-full rounded-xl border border-white/10 bg-[#111111] px-4 py-3 text-[#f3efe4] outline-none focus:border-[#c9ff5f]/60"
              ></textarea>
            </label>

            <label class="block">
              <span class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                Cover
              </span>
              <input
                id="field-cover"
