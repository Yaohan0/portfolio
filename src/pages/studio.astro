            { name: "type", label: "Type", type: "text" },
            { name: "status", label: "Status", type: "text" },
            { name: "date", label: "Date", type: "text" },
            { name: "evidence", label: "Evidence", type: "list" },
            { name: "link", label: "Related Link", type: "text" },
          ],
        },

        skills: {
          label: "Skills",
          titleField: "name",
          summaryField: "description",
          pageBase: "/skills/",
          defaults: {
            name: "Untitled Skill",
            title: "Untitled Skill",
            slug: "untitled-skill",
            order: 999,
            category: "General",
            level: "Learning",
            status: "Active",
            description: "",
            evidence: [],
            tools: [],
            notes: "",
            cover: "",
          },
          fields: [
            { name: "order", label: "Order", type: "number" },
            { name: "category", label: "Category", type: "text" },
            { name: "level", label: "Level", type: "text" },
            { name: "status", label: "Status", type: "text" },
            { name: "evidence", label: "Evidence", type: "list" },
            { name: "tools", label: "Tools", type: "list" },
            { name: "notes", label: "Notes", type: "textarea" },
          ],
        },
      };

      let collection = "writeups";
      let docs = [];
      let currentSlug = "";
      let currentData = {};
      let blocks = [];
      let isDirty = false;
      let studioMode = "surface";
      let driveSubject = "ALL";
      let driveFolderOpen = false;
      let driveSubfolder = "";
      let driveSelection = "";
      let selectedSurfaceBlock = null;

      const noteSubjects = {
        ECOMM: "Effective Communication",
        ENNK: "Enterprise Networking",
        EHIP: "Ethical Hacking & Intrusion Prevention",
        FDS: "Forensics in Digital Security",
        SADS: "Servers Administration & Security",
      };

      const $ = (id) => document.getElementById(id);
      const setSaveState = (state, label) => {
        isDirty = state === "dirty";
        const node = $("save-status");
        node.className = `studio-status ${state}`;
        node.textContent = label;
      };
      const markDirty = () => setSaveState("dirty", "UNSAVED");

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const slugify = (value) =>
        String(value || "")
          .toLowerCase()
          .trim()
          .replace(/['"]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");

      const config = () => collectionConfigs[collection];

      const displayTitle = (data) => {
        const field = config().titleField;
        return data[field] || data.title || data.name || "Untitled";
      };

      const displaySummary = (data) => {
        const field = config().summaryField;
        return data[field] || data.summary || data.description || "";
      };

      const normalizeListForInput = (value) => {
        if (Array.isArray(value)) return value.join(", ");
        return value || "";
      };

      const request = async (url, options = {}) => {
        const response = await fetch(url, options);
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Request failed");
        }

        return data;
      };

      const renderCollectionButtons = () => {
        $("collection-buttons").innerHTML = Object.entries(collectionConfigs)
          .map(([name, item]) => {
            const active = name === collection;

            return `
              <button
                data-collection="${name}"
                class="collection-button rounded-xl border ${
                  active
                    ? "border-[#c9ff5f]/40 bg-[#c9ff5f] text-black"
                    : "border-white/10 bg-black/30 text-[#a9a196]"
                } px-4 py-3 text-xs font-black uppercase tracking-widest transition hover:border-[#c9ff5f]/60"
              >
                ${item.label}
              </button>
            `;
          })
          .join("");

        document.querySelectorAll(".collection-button").forEach((button) => {
          button.addEventListener("click", () => {
            setCollection(button.dataset.collection);
          });
        });
      };

      const loadDocs = async () => {
        const data = await request(`${API}/docs?collection=${collection}`);
        docs = data.docs;
        renderDocList();
        renderFileBrowser();
      };

      const renderDocList = () => {
        const query = $("doc-search").value.trim().toLowerCase();
        const visibleDocs = docs.filter((doc) => `${displayTitle(doc.data)} ${doc.slug}`.toLowerCase().includes(query));
        $("doc-list").innerHTML = visibleDocs.length ? visibleDocs
          .map((doc) => {
            const title = displayTitle(doc.data);

            return `
              <button
                data-slug="${escapeHtml(doc.slug)}"
                class="doc-button ${doc.slug === currentSlug ? "active" : ""} w-full rounded-xl border border-white/10 bg-black/20 p-4 text-left transition hover:border-[#c9ff5f]/60"
              >
                <p class="text-sm font-bold text-[#f3efe4]">${escapeHtml(title)}</p>
                <p class="mt-1 font-mono text-[0.65rem] uppercase tracking-widest text-[#6f6a63]">${escapeHtml(doc.slug)}</p>
              </button>
            `;
          })
          .join("") : `<p class="studio-empty">NO MATCHING DOCUMENTS</p>`;

        document.querySelectorAll(".doc-button").forEach((button) => {
          button.addEventListener("click", () => loadDoc(button.dataset.slug));
        });
      };

      const loadDoc = async (slug) => {
        const doc = await request(`${API}/docs/${collection}/${slug}`);

        currentSlug = slug;
        currentData = doc.data;
        blocks = doc.blocks;

        fillFields();
        renderBlocks();
        renderPreview();
        renderDocList();
        renderFileBrowser();
        setSaveState("saved", "SAVED");
      };

      const newDoc = () => {
        currentData = structuredClone(config().defaults);
        currentSlug = currentData.slug;
        blocks = [{ type: "paragraph", text: "" }];

        fillFields();
        renderBlocks();
        renderPreview();
        renderFileBrowser();
        markDirty();
      };

      const renderMetadataFields = () => {
        $("metadata-fields").innerHTML = config().fields
          .map((field) => {
            const value = currentData[field.name];

            if (field.type === "checkbox") {
              return `
                <label class="flex items-center gap-3 rounded-xl border border-white/10 bg-black/20 px-4 py-3">
                  <input
                    data-meta="${field.name}"
                    type="checkbox"
                    ${value ? "checked" : ""}
                    class="meta-input h-4 w-4"
                  />
                  <span class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                    ${field.label}
                  </span>
                </label>
              `;
            }

            if (field.type === "textarea") {
              return `
                <label class="block md:col-span-3">
                  <span class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                    ${field.label}
                  </span>
                  <textarea
                    data-meta="${field.name}"
                    rows="3"
                    class="meta-input mt-2 w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-[#f3efe4] outline-none focus:border-[#c9ff5f]/60"
                  >${escapeHtml(value || "")}</textarea>
                </label>
              `;
            }

            if (field.type === "select") {
              return `
                <label class="block">
                  <span class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">${field.label}</span>
                  <select data-meta="${field.name}" class="meta-input mt-2 w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-[#f3efe4] outline-none focus:border-[#c9ff5f]/60">
                    ${field.options.map((option) => `<option value="${escapeHtml(option)}" ${value === option ? "selected" : ""}>${escapeHtml(option)}</option>`).join("")}
                  </select>
                </label>
              `;
            }

            return `
              <label class="block">
                <span class="font-mono text-xs uppercase tracking-widest text-[#a9a196]">
                  ${field.label}
                </span>
                <input
                  data-meta="${field.name}"
                  type="${field.type === "number" ? "number" : "text"}"
                  value="${escapeHtml(field.type === "list" ? normalizeListForInput(value) : value || "")}"
                  class="meta-input mt-2 w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-[#f3efe4] outline-none focus:border-[#c9ff5f]/60"
                />
              </label>
            `;
          })
          .join("");

        document.querySelectorAll(".meta-input").forEach((input) => {
          input.addEventListener("input", renderPreview);
          input.addEventListener("change", renderPreview);
        });
      };

      const fillFields = () => {
        const titleField = config().titleField;
        const summaryField = config().summaryField;

        $("current-path").textContent = `src/content/${collection}/${currentData.slug}.md`;
        $("editor-title").textContent = `${config().label} Editor`;
        $("title-label").textContent = titleField === "name" ? "Name" : "Title";
        $("summary-label").textContent =
          config().summaryLabel || (summaryField === "description" ? "Description" : "Summary");

        $("field-title").value = currentData[titleField] || currentData.title || currentData.name || "";
        $("field-slug").value = currentData.slug || "";
        $("field-summary").value = currentData[summaryField] || "";
        $("field-cover").value = currentData.cover || "";

        $("open-page").href = config().singlePage ? "/" : `${config().pageBase}${currentData.slug || ""}`;

        renderMetadataFields();
      };

      const collectFields = () => {
        const titleField = config().titleField;
        const summaryField = config().summaryField;

        currentData[titleField] = $("field-title").value;

        if (titleField === "name") {
          currentData.title = $("field-title").value;
        } else {
          currentData.title = $("field-title").value;
        }

        currentData.slug = slugify($("field-slug").value || $("field-title").value);
        currentData[summaryField] = $("field-summary").value;

        if (summaryField !== "summary") {
          currentData.summary = $("field-summary").value;
        }

        currentData.cover = $("field-cover").value;

        document.querySelectorAll(".meta-input").forEach((input) => {
          const name = input.dataset.meta;

          if (input.type === "checkbox") {
            currentData[name] = input.checked;
          } else {
            currentData[name] = input.value;
          }
        });

        if (collection === "profile") {
          delete currentData.title;
          delete currentData.summary;
        }

        $("open-page").href = config().singlePage ? "/" : `${config().pageBase}${currentData.slug || ""}`;

        return currentData;
      };

      const blockControls = (index) => `
        <div class="flex gap-2">
          <button data-up="${index}" class="move-up rounded-lg border border-white/10 px-2 py-1 text-xs text-[#a9a196]">↑</button>
          <button data-down="${index}" class="move-down rounded-lg border border-white/10 px-2 py-1 text-xs text-[#a9a196]">↓</button>
          <button data-delete="${index}" class="delete-block rounded-lg border border-red-500/30 px-2 py-1 text-xs text-red-300">Delete</button>
        </div>
      `;

      const blockTemplate = (block, index) => {
        const controls = blockControls(index);

        if (block.type === "folder") {
          return `<div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-[#e2b84c]/30 bg-[#e2b84c]/5 p-4"><div class="mb-3 flex justify-between"><p class="font-mono text-xs text-[#e2b84c]">Folder</p>${controls}</div><input data-index="${index}" data-field="name" value="${escapeHtml(block.name || "Notes")}" class="block-input w-full bg-transparent text-xl font-bold outline-none" /></div>`;
        }

        if (block.type === "heading" || block.type === "subheading") {
          return `
            <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-white/10 bg-[#111111] p-4">
              <div class="mb-3 flex justify-between">
                <p class="font-mono text-xs text-[#c9ff5f]">${block.type === "heading" ? "Heading" : "Subheading"}</p>
                ${controls}
              </div>
              <input
                data-index="${index}"
                data-field="text"
                value="${escapeHtml(block.text || "")}"
                class="block-input w-full bg-transparent ${block.type === "heading" ? "text-2xl" : "text-xl"} font-bold outline-none"
              />
            </div>
          `;
        }

        if (block.type === "paragraph") {
          return `
            <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-white/10 bg-[#111111] p-4">
              <div class="mb-3 flex justify-between">
                <p class="font-mono text-xs text-[#c9ff5f]">Paragraph</p>
                ${controls}
              </div>
              <textarea
                data-index="${index}"
                data-field="text"
                rows="5"
                class="block-input w-full resize-y bg-transparent leading-7 outline-none"
              >${escapeHtml(block.text || "")}</textarea>
            </div>
          `;
        }

        if (block.type === "image") {
          return `
            <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-white/10 bg-[#111111] p-4">
              <div class="mb-3 flex justify-between">
                <p class="font-mono text-xs text-[#c9ff5f]">Image</p>
                ${controls}
              </div>

              ${block.src ? `<img src="${escapeHtml(block.src)}" class="mb-4 max-h-72 w-full rounded-xl object-cover" />` : ""}

              <input
                data-index="${index}"
                data-field="src"
                value="${escapeHtml(block.src || "")}"
                placeholder="/portfolio/uploads/image.png"
                class="block-input mb-3 w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm outline-none"
              />

              <input
                data-index="${index}"
                data-field="alt"
                value="${escapeHtml(block.alt || "")}"
                placeholder="Alt text"
                class="block-input mb-3 w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm outline-none"
              />

              <input data-upload-image="${index}" type="file" class="image-upload text-sm text-[#a9a196]" />
            </div>
          `;
        }

        if (block.type === "file") {
          return `
            <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-white/10 bg-[#111111] p-4">
              <div class="mb-3 flex justify-between">
                <p class="font-mono text-xs text-[#c9ff5f]">File</p>
                ${controls}
              </div>

              <input
                data-index="${index}"
                data-field="name"
                value="${escapeHtml(block.name || "")}"
                placeholder="File name"
                class="block-input mb-3 w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm outline-none"
              />

              <input
                data-index="${index}"
                data-field="url"
                value="${escapeHtml(block.url || "")}"
                placeholder="/portfolio/uploads/file.pdf"
                class="block-input mb-3 w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm outline-none"
              />

              <input data-upload-file="${index}" type="file" class="file-upload text-sm text-[#a9a196]" />
            </div>
          `;
        }

        if (block.type === "code") {
          return `
            <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-white/10 bg-[#111111] p-4">
              <div class="mb-3 flex justify-between">
                <p class="font-mono text-xs text-[#c9ff5f]">Code</p>
                ${controls}
              </div>

              <input
                data-index="${index}"
                data-field="language"
                value="${escapeHtml(block.language || "")}"
                placeholder="bash, js, py..."
                class="block-input mb-3 w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm outline-none"
              />

              <textarea
                data-index="${index}"
                data-field="code"
                rows="7"
                class="block-input w-full resize-y rounded-xl border border-white/10 bg-black/30 px-3 py-2 font-mono text-sm outline-none"
              >${escapeHtml(block.code || "")}</textarea>
            </div>
          `;
        }

        if (block.type === "callout") {
          return `
            <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-[#ead27c]/20 bg-[#ead27c]/5 p-4">
              <div class="mb-3 flex justify-between">
                <p class="font-mono text-xs text-[#ead27c]">Callout</p>
                ${controls}
              </div>

              <textarea
                data-index="${index}"
                data-field="text"
                rows="3"
                class="block-input w-full resize-y bg-transparent leading-7 outline-none"
              >${escapeHtml(block.text || "")}</textarea>
            </div>
          `;
        }

        return `
          <div id="block-card-${index}" data-editor-block="${index}" class="block-card rounded-2xl border border-white/10 bg-[#111111] p-4">
            <div class="flex justify-between">
              <p class="font-mono text-xs text-[#c9ff5f]">Divider</p>
              ${controls}
            </div>
            <div class="mt-4 h-px bg-white/10"></div>
          </div>
        `;
      };

      const renderBlocks = () => {
        $("blocks").innerHTML = blocks.map(blockTemplate).join("");

        document.querySelectorAll(".block-input").forEach((input) => {
          input.addEventListener("input", () => {
            const index = Number(input.dataset.index);
            const field = input.dataset.field;
            blocks[index][field] = input.value;
            renderPreview();
          });
        });

        document.querySelectorAll(".move-up").forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.dataset.up);
            if (index === 0) return;

            [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]];

            renderBlocks();
            renderPreview();
          });
        });

        document.querySelectorAll(".move-down").forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.dataset.down);
            if (index === blocks.length - 1) return;

            [blocks[index + 1], blocks[index]] = [blocks[index], blocks[index + 1]];

            renderBlocks();
            renderPreview();
          });
        });

        document.querySelectorAll(".delete-block").forEach((button) => {
          button.addEventListener("click", () => {
            const index = Number(button.dataset.delete);
            blocks.splice(index, 1);

            renderBlocks();
            renderPreview();
          });
        });

        document.querySelectorAll(".image-upload").forEach((input) => {
          input.addEventListener("change", async () => {
            const index = Number(input.dataset.uploadImage);
            const file = input.files[0];
            if (!file) return;

            const url = await uploadFile(file);
            blocks[index].src = url;

            renderBlocks();
            renderPreview();
          });
        });

        document.querySelectorAll(".file-upload").forEach((input) => {
          input.addEventListener("change", async () => {
            const index = Number(input.dataset.uploadFile);
            const file = input.files[0];
            if (!file) return;

            const url = await uploadFile(file);
            blocks[index].url = url;
            blocks[index].name = file.name;

            renderBlocks();
            renderPreview();
          });
        });
      };

      const selectSurfaceBlock = (index) => {
        selectedSurfaceBlock = Number.isInteger(index) ? index : null;
        document.querySelectorAll("#preview .surface-block").forEach((node) => {
          node.classList.toggle("surface-selected", Number(node.dataset.surfaceBlock) === selectedSurfaceBlock);
        });
        const selected = selectedSurfaceBlock === null ? null : blocks[selectedSurfaceBlock];
        $("surface-selection").textContent = selected ? `${selected.type} ${String(selectedSurfaceBlock + 1).padStart(2, "0")}` : "Select a block";
      };

      const wireSurfaceEditor = () => {
        const titleNode = $("preview").querySelector('[data-surface-field="title"]');
        const summaryNode = $("preview").querySelector('[data-surface-field="summary"]');
        titleNode?.addEventListener("input", () => {
          const value = titleNode.innerText.replace(/\n/g, " ");
          $("field-title").value = value;
          currentData[config().titleField] = value;
          markDirty();
        });
        summaryNode?.addEventListener("input", () => {
          const value = summaryNode.innerText;
          $("field-summary").value = value;
          currentData[config().summaryField] = value;
          markDirty();
        });
        document.querySelectorAll("#preview .surface-block").forEach((node) => {
          const index = Number(node.dataset.surfaceBlock);
          node.addEventListener("click", () => selectSurfaceBlock(index));
          const editable = node.querySelector("[data-surface-key]");
          editable?.addEventListener("input", () => {
            const key = editable.dataset.surfaceKey;
            blocks[index][key] = editable.innerText;
            const formInput = document.querySelector(`.block-input[data-index="${index}"][data-field="${key}"]`);
            if (formInput) formInput.value = blocks[index][key];
            markDirty();
          });
        });
      };

      const renderPreview = () => {
        collectFields();
        const title = displayTitle(currentData);
        const summary = displaySummary(currentData);
        const cover = currentData.cover ? `<img src="${escapeHtml(currentData.cover)}" alt="" class="surface-cover" />` : "";
        const body = blocks.map((block, index) => {
          const selected = index === selectedSurfaceBlock ? " surface-selected" : "";
          const open = `<section class="surface-block${selected}" data-surface-block="${index}" data-block-label="${escapeHtml(block.type)}">`;
          if (block.type === "heading") return `${open}<h2 data-surface-key="text" contenteditable="true">${escapeHtml(block.text || "New heading")}</h2></section>`;
          if (block.type === "folder") return `${open}<h2>📁 ${escapeHtml(block.name || "Notes")}</h2></section>`;
          if (block.type === "subheading") return `${open}<h3 data-surface-key="text" contenteditable="true">${escapeHtml(block.text || "New subheading")}</h3></section>`;
          if (block.type === "paragraph") return `${open}<p data-surface-key="text" contenteditable="true">${escapeHtml(block.text || "Start writing here...").replace(/\n/g, "<br>")}</p></section>`;
          if (block.type === "image") return `${open}${block.src ? `<img src="${escapeHtml(block.src)}" alt="${escapeHtml(block.alt || "")}" class="surface-cover" />` : `<button class="surface-file" type="button">Choose an image in the inspector <span>↗</span></button>`}</section>`;
          if (block.type === "file") return `${open}<a href="${escapeHtml(block.url || "#")}" class="surface-file"><span data-surface-key="name" contenteditable="true">${escapeHtml(block.name || "Attached file")}</span><span>OPEN ↗</span></a></section>`;
          if (block.type === "code") return `${open}<pre class="overflow-x-auto rounded-xl bg-[#20252b] p-5"><code data-surface-key="code" contenteditable="true">${escapeHtml(block.code || "# code")}</code></pre></section>`;
          if (block.type === "callout") return `${open}<blockquote data-surface-key="text" contenteditable="true" class="rounded-xl border border-[#ead27c]/30 bg-[#ead27c]/5 p-5 text-[#ead27c]">${escapeHtml(block.text || "Add a callout...")}</blockquote></section>`;
          if (block.type === "divider") return `${open}<hr class="border-white/15" /></section>`;
          return "";
        }).join("");

        $("preview").innerHTML = `
          <p class="surface-label">${escapeHtml(config().label)} / LIVE SURFACE</p>
          <h1 class="surface-title" data-surface-field="title" contenteditable="true">${escapeHtml(title || "Untitled")}</h1>
          <p class="surface-summary" data-surface-field="summary" contenteditable="true">${escapeHtml(summary || "Add a short summary...")}</p>
          ${cover}
          <div>${body}</div>
        `;
        wireSurfaceEditor();
      };

      const openDriveNote = async (slug) => {
        await loadDoc(slug);
        setStudioMode("surface");
      };

      const driveFolders = () => {
        const names = new Set(["Notes", "Assignments"]);
        docs.filter((doc) => doc.data.subject === driveSubject).forEach((doc) => names.add(doc.data.folder || "Notes"));
        blocks.forEach((block) => {
          if (block.type === "folder" && block.name) names.add(block.name);
          if (["file", "image"].includes(block.type)) names.add(block.folder || "Notes");
        });
        return [...names].filter(Boolean);
      };

      const openDriveFolder = async (subject) => {
        if (!noteSubjects[subject]) return;
        driveSubject = subject;
        driveFolderOpen = true;
        driveSubfolder = "";
        driveSelection = "";
        const subjectDocs = docs.filter((doc) => doc.data.subject === subject);
        const indexDoc = subjectDocs.find((doc) => /subject index/i.test(displayTitle(doc.data))) || subjectDocs[0];
        if (indexDoc && currentSlug !== indexDoc.slug) await loadDoc(indexDoc.slug);
        renderFileBrowser();
      };

      const closeDriveFolder = () => {
        if (driveSubfolder) {
          driveSubfolder = "";
          driveSelection = "";
          renderFileBrowser();
          return;
        }
        driveFolderOpen = false;
        driveSubject = "ALL";
        driveSelection = "";
        renderFileBrowser();
      };

      const openDriveSubfolder = (folder) => {
        driveSubfolder = folder;
        driveSelection = "";
        renderFileBrowser();
      };

      const renderFileBrowser = () => {
        if (!$("drive-grid")) return;
        const subjectCodes = Object.keys(noteSubjects);
        $("drive-back").hidden = !driveFolderOpen;
        $("drive-new-folder").hidden = !driveFolderOpen || Boolean(driveSubfolder);
        ["drive-new-note", "drive-upload-images", "drive-upload"].forEach((id) => { $(id).hidden = !driveSubfolder; });
        $("drive-title").textContent = driveFolderOpen ? `${noteSubjects[driveSubject]} (${driveSubject})` : "Subject library";
        $("drive-path").textContent = driveSubfolder ? `Notes / ${driveSubject} / ${driveSubfolder}` : driveFolderOpen ? `Notes / ${noteSubjects[driveSubject]}` : "Notes / Subject folders";
        $("drive-drop").querySelector(".drive-path span:last-child").textContent = driveSubfolder ? "Drop files into this folder" : driveFolderOpen ? "Choose or create a folder" : "Double-click a folder to open";

        $("drive-subjects").innerHTML = `<button class="drive-subject ${!driveFolderOpen ? "active" : ""}" data-drive-root type="button">All subjects<span>${subjectCodes.length} folders</span></button>${subjectCodes.map((subject) => {
          const count = docs.filter((doc) => doc.data.subject === subject).length;
          return `<button class="drive-subject ${driveFolderOpen && driveSubject === subject ? "active" : ""}" data-drive-folder="${subject}" type="button">${subject}<span>${count} ${count === 1 ? "note" : "notes"}</span></button>`;
        }).join("")}`;

        if (!driveFolderOpen) {
          $("drive-grid").innerHTML = subjectCodes.map((subject) => {
            const subjectDocs = docs.filter((doc) => doc.data.subject === subject);
            const latest = subjectDocs.map((doc) => doc.data.date).filter(Boolean).sort().at(-1) || "No date";
            return `<article class="drive-card drive-folder-card ${driveSelection === subject ? "is-selected" : ""}" data-drive-folder-card="${subject}" tabindex="0" aria-label="${escapeHtml(noteSubjects[subject])} folder. Double-click to open.">
              <button class="drive-card-actions" data-drive-folder="${subject}" aria-label="Open ${escapeHtml(noteSubjects[subject])}" type="button">↗</button>
              <div class="drive-folder-icon" aria-hidden="true"></div>
              <h3>${escapeHtml(noteSubjects[subject])}</h3>
              <p>${subject} · ${subjectDocs.length} ${subjectDocs.length === 1 ? "item" : "items"} · ${escapeHtml(latest)}</p>
              <p class="drive-card-hint">Double-click to open</p>
            </article>`;
          }).join("");
          $("drive-attachments").hidden = true;
        } else if (!driveSubfolder) {
          const folders = driveFolders();
          $("drive-grid").innerHTML = folders.map((folder) => {
            const docCount = docs.filter((doc) => doc.data.subject === driveSubject && (doc.data.folder || "Notes") === folder && !/subject index/i.test(displayTitle(doc.data))).length;
            const fileCount = blocks.filter((block) => ["file", "image"].includes(block.type) && (block.folder || "Notes") === folder).length;
            return `<article class="drive-card drive-folder-card ${driveSelection === folder ? "is-selected" : ""}" data-drive-subfolder-card="${escapeHtml(folder)}" tabindex="0" aria-label="${escapeHtml(folder)} folder. Double-click to open."><button class="drive-card-actions" data-drive-subfolder="${escapeHtml(folder)}" aria-label="Open ${escapeHtml(folder)}" type="button">↗</button><div class="drive-folder-icon" aria-hidden="true"></div><h3>${escapeHtml(folder)}</h3><p>${docCount + fileCount} ${docCount + fileCount === 1 ? "item" : "items"}</p><p class="drive-card-hint">Double-click to open</p></article>`;
          }).join("");
          $("drive-attachments").hidden = true;
        } else {
          const visible = docs.filter((doc) => doc.data.subject === driveSubject && (doc.data.folder || "Notes") === driveSubfolder && !/subject index/i.test(displayTitle(doc.data)));
          const attached = blocks.map((block, index) => ({ block, index })).filter(({ block }) => ["file", "image"].includes(block.type) && (block.folder || "Notes") === driveSubfolder);
          const noteCards = visible.map((doc) => `
            <article class="drive-card ${driveSelection === doc.slug ? "is-selected" : ""}" data-drive-note-card="${escapeHtml(doc.slug)}" tabindex="0" aria-label="${escapeHtml(displayTitle(doc.data))}. Double-click to edit.">
              <button class="drive-card-actions" data-drive-open="${escapeHtml(doc.slug)}" aria-label="Edit ${escapeHtml(displayTitle(doc.data))}" type="button">↗</button>
              <span class="drive-card-icon">TXT</span>
              <h3>${escapeHtml(displayTitle(doc.data))}</h3>
              <p>${escapeHtml(doc.data.date || doc.slug)}</p>
              <p class="drive-card-hint">Double-click to edit</p>
            </article>
          `).join("");
          const fileCards = attached.map(({ block, index }) => {
            const isImage = block.type === "image";
            const label = isImage ? (block.alt || "Untitled image") : (block.name || "Untitled file");
            const url = isImage ? block.src : block.url;
            return `<article class="drive-card"><a class="drive-open" href="${escapeHtml(url || "#")}" target="_blank" rel="noreferrer">${isImage && url ? `<img class="drive-media-thumb" src="${escapeHtml(url)}" alt="" />` : `<span class="drive-card-icon">FILE</span>`}<h3>${escapeHtml(label)}</h3><p>${isImage ? "IMAGE" : "DOCUMENT"}</p></a><button class="drive-card-actions" data-remove-file="${index}" aria-label="Remove ${escapeHtml(label)}" type="button">×</button></article>`;
          }).join("");
          $("drive-grid").innerHTML = noteCards + fileCards || `<div class="drive-empty-folder"><div><b>This folder is empty</b>Create a text note, add images, or drop files here.</div></div>`;
          $("drive-attachments").hidden = true;
        }

        document.querySelectorAll("[data-drive-root]").forEach((button) => button.addEventListener("click", closeDriveFolder));
        document.querySelectorAll("[data-drive-folder]").forEach((button) => button.addEventListener("click", () => openDriveFolder(button.dataset.driveFolder)));
        document.querySelectorAll("[data-drive-folder-card]").forEach((card) => {
          card.addEventListener("click", () => { driveSelection = card.dataset.driveFolderCard; renderFileBrowser(); });
          card.addEventListener("dblclick", () => openDriveFolder(card.dataset.driveFolderCard));
          card.addEventListener("keydown", (event) => { if (event.key === "Enter") openDriveFolder(card.dataset.driveFolderCard); });
        });
        document.querySelectorAll("[data-drive-subfolder]").forEach((button) => button.addEventListener("click", () => openDriveSubfolder(button.dataset.driveSubfolder)));
        document.querySelectorAll("[data-drive-subfolder-card]").forEach((card) => {
          card.addEventListener("click", () => { driveSelection = card.dataset.driveSubfolderCard; renderFileBrowser(); });
          card.addEventListener("dblclick", () => openDriveSubfolder(card.dataset.driveSubfolderCard));
          card.addEventListener("keydown", (event) => { if (event.key === "Enter") openDriveSubfolder(card.dataset.driveSubfolderCard); });
        });
        document.querySelectorAll("[data-drive-open]").forEach((button) => button.addEventListener("click", () => openDriveNote(button.dataset.driveOpen)));
        document.querySelectorAll("[data-drive-note-card]").forEach((card) => {
          card.addEventListener("click", () => { driveSelection = card.dataset.driveNoteCard; renderFileBrowser(); });
          card.addEventListener("dblclick", () => openDriveNote(card.dataset.driveNoteCard));
          card.addEventListener("keydown", (event) => { if (event.key === "Enter") openDriveNote(card.dataset.driveNoteCard); });
        });
        document.querySelectorAll("[data-remove-file]").forEach((button) => button.addEventListener("click", () => { blocks.splice(Number(button.dataset.removeFile), 1); renderBlocks(); renderPreview(); renderFileBrowser(); markDirty(); }));
      };

      const addBlock = (type) => {
        const defaults = {
          heading: { type: "heading", text: "New heading" },
          subheading: { type: "subheading", text: "New subheading" },
          paragraph: { type: "paragraph", text: "" },
          image: { type: "image", src: "", alt: "" },
          file: { type: "file", name: "", url: "" },
          code: { type: "code", language: "bash", code: "" },
          callout: { type: "callout", text: "" },
          divider: { type: "divider" },
        };

        blocks.push(defaults[type]);
        selectedSurfaceBlock = blocks.length - 1;
        renderBlocks();
        renderPreview();
        renderFileBrowser();
      };

      const setStudioMode = async (mode) => {
        studioMode = mode;
        const workspace = $("studio-workspace");
        workspace.classList.remove("mode-surface", "mode-form", "mode-files", "preview-hidden");
        workspace.classList.add(`mode-${mode}`);
        document.querySelectorAll(".studio-mode").forEach((button) => button.classList.toggle("active", button.dataset.mode === mode));
        if (mode === "files") {
          if (collection !== "notes") await setCollection("notes");
          renderFileBrowser();
        }
      };

      const setSurfaceWidth = (width) => {
        $("preview").classList.remove("surface-tablet", "surface-mobile");
        if (width !== "desktop") $("preview").classList.add(`surface-${width}`);
        document.querySelectorAll("[data-width]").forEach((button) => button.classList.toggle("is-active", button.dataset.width === width));
      };

      const formatSelectedSurfaceBlock = (type) => {
        if (selectedSurfaceBlock === null || !blocks[selectedSurfaceBlock]) return;
        const block = blocks[selectedSurfaceBlock];
        const text = block.text || block.name || block.code || "";
        blocks[selectedSurfaceBlock] = type === "paragraph" ? { type, text } : { type, text: text || (type === "heading" ? "New heading" : "New subheading") };
        renderBlocks();
        renderPreview();
        markDirty();
      };

      const attachDriveFiles = async (files, forceImage = false) => {
        if (!files?.length) return;
        if (collection !== "notes") await setCollection("notes");
        if (!driveFolderOpen || !driveSubfolder || !noteSubjects[driveSubject]) {
          alert("Open a folder inside the subject before adding files.");
          return;
        }
        if (currentData.subject !== driveSubject) {
          const subjectDocs = docs.filter((doc) => doc.data.subject === driveSubject);
          const target = subjectDocs.find((doc) => /subject index/i.test(displayTitle(doc.data))) || subjectDocs[0];
          if (target) await loadDoc(target.slug);
        }
        setSaveState("dirty", "UPLOADING...");
        for (const file of files) {
          const url = await uploadFile(file);
          const isImage = forceImage || file.type.startsWith("image/");
          blocks.push(isImage ? { type: "image", src: url, alt: file.name, folder: driveSubfolder } : { type: "file", name: file.name, url, folder: driveSubfolder });
        }
        selectedSurfaceBlock = blocks.length - 1;
        renderBlocks();
        renderPreview();
        renderFileBrowser();
        markDirty();
      };

      const uploadFile = async (file) => {
        const formData = new FormData();
        formData.append("file", file);

        const response = await fetch(`${API}/upload`, {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Upload failed");
        }

        return data.url;
      };

      const saveDoc = async () => {
        let savedLocally = false;

        try {
          setSaveState("dirty", "SAVING...");
          collectFields();

          const result = await request(`${API}/docs/${collection}/${currentSlug}`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              data: currentData,
              blocks,
            }),
          });

          currentSlug = result.slug;
          savedLocally = true;

          await loadDocs();
          await loadDoc(currentSlug);

          setSaveState("publishing", "PUBLISHING...");

          const publishResult = await request(`${API}/publish`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              message: `Update ${config().label}: ${displayTitle(currentData)}`,
            }),
          });

          setSaveState("saved", publishResult.status === "up-to-date" ? "LIVE · CURRENT" : "LIVE · PUBLISHED");
        } catch (error) {
          setSaveState(savedLocally ? "local" : "dirty", savedLocally ? "SAVED · LOCAL ONLY" : "SAVE FAILED");
          alert(error.message);
        }
      };

      const duplicateDoc = () => {
        collectFields();
        const copy = structuredClone(currentData);
        const titleField = config().titleField;
        copy[titleField] = `${displayTitle(copy)} Copy`;
        copy.title = copy[titleField];
        copy.slug = `${currentData.slug || currentSlug}-copy`;
        currentData = copy;
        currentSlug = copy.slug;
        blocks = structuredClone(blocks);
        fillFields(); renderBlocks(); renderPreview(); markDirty();
      };

      const deleteDoc = async () => {
        if (!currentSlug || currentSlug.startsWith("untitled")) return;
        if (!confirm(`Delete ${displayTitle(currentData)}? This cannot be undone.`)) return;
        let deletedLocally = false;
        try {
          await request(`${API}/docs/${collection}/${currentSlug}`, { method: "DELETE" });
          deletedLocally = true;
          setSaveState("publishing", "PUBLISHING...");
          await request(`${API}/publish`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message: `Delete ${config().label}: ${displayTitle(currentData)}` }),
          });
          await loadDocs();
          if (docs.length) await loadDoc(docs[0].slug); else newDoc();
          setSaveState("saved", "LIVE · DELETED");
        } catch (error) {
          setSaveState(deletedLocally ? "local" : "dirty", deletedLocally ? "DELETED · LOCAL ONLY" : "DELETE FAILED");
          alert(error.message);
        }
      };

      const setCollection = async (nextCollection) => {
        collection = nextCollection;

        renderCollectionButtons();
        await loadDocs();

        if (docs.length > 0) {
          await loadDoc(docs[0].slug);
        } else {
          newDoc();
        }
      };

      $("new-doc").addEventListener("click", newDoc);
      $("save-doc").addEventListener("click", saveDoc);
      $("duplicate-doc").addEventListener("click", duplicateDoc);
      $("delete-doc").addEventListener("click", deleteDoc);
      $("doc-search").addEventListener("input", renderDocList);
      $("toggle-preview").addEventListener("click", () => setStudioMode(studioMode === "form" ? "surface" : "form"));
      document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s") { event.preventDefault(); saveDoc(); }
      });
      document.addEventListener("input", (event) => { if (event.target.id !== "doc-search") markDirty(); });
      document.addEventListener("click", (event) => { if (event.target.closest('.add-block,.move-up,.move-down,.delete-block')) markDirty(); });
      addEventListener("beforeunload", (event) => { if (isDirty) { event.preventDefault(); event.returnValue = ""; } });

      $("field-title").addEventListener("input", () => {
        if (!$("field-slug").value || $("field-slug").value.startsWith("untitled")) {
          $("field-slug").value = slugify($("field-title").value);
        }

        renderPreview();
      });

      ["field-slug", "field-summary", "field-cover"].forEach((id) => {
        $(id).addEventListener("input", renderPreview);
      });

      $("cover-upload").addEventListener("change", async () => {
        const file = $("cover-upload").files[0];
        if (!file) return;

        const url = await uploadFile(file);
        $("field-cover").value = url;

        renderPreview();
      });

      document.querySelectorAll(".add-block").forEach((button) => {
        button.addEventListener("click", () => addBlock(button.dataset.add));
      });

      document.querySelectorAll(".studio-mode").forEach((button) => {
        button.addEventListener("click", () => setStudioMode(button.dataset.mode));
      });
      document.querySelectorAll("[data-surface-add]").forEach((button) => {
        button.addEventListener("click", () => addBlock(button.dataset.surfaceAdd));
      });
      document.querySelectorAll("[data-surface-format]").forEach((button) => {
        button.addEventListener("click", () => formatSelectedSurfaceBlock(button.dataset.surfaceFormat));
      });
      document.querySelectorAll("[data-width]").forEach((button) => {
        button.addEventListener("click", () => setSurfaceWidth(button.dataset.width));
      });

      $("drive-new-note").addEventListener("click", async () => {
        if (collection !== "notes") await setCollection("notes");
        if (!driveSubfolder) return;
        newDoc();
        currentData.subject = driveSubject;
        currentData.folder = driveSubfolder || "Notes";
        currentData.title = `Untitled ${driveSubject} Note`;
        currentData.slug = `untitled-${driveSubject.toLowerCase()}-note`;
        currentData.summary = `New note for ${noteSubjects[driveSubject]}.`;
        currentSlug = currentData.slug;
        fillFields();
        renderPreview();
        setStudioMode("surface");
      });
      $("drive-new-folder").addEventListener("click", () => {
        if (!driveFolderOpen || driveSubfolder) return;
        const name = prompt("Folder name", "Assignments")?.trim();
        if (!name) return;
        if (driveFolders().some((folder) => folder.toLowerCase() === name.toLowerCase())) {
          alert("That folder already exists.");
          return;
        }
        blocks.push({ type: "folder", name });
        renderBlocks();
        renderPreview();
        markDirty();
        openDriveSubfolder(name);
      });
      $("drive-back").addEventListener("click", closeDriveFolder);
      $("drive-upload").addEventListener("click", () => $("drive-file-input").click());
      $("drive-upload-images").addEventListener("click", () => $("drive-image-input").click());
      $("drive-file-input").addEventListener("change", async () => {
        await attachDriveFiles([...$("drive-file-input").files]);
        $("drive-file-input").value = "";
      });
      $("drive-image-input").addEventListener("change", async () => {
        await attachDriveFiles([...$("drive-image-input").files], true);
        $("drive-image-input").value = "";
      });
      const driveDrop = $("drive-drop");
      ["dragenter", "dragover"].forEach((eventName) => driveDrop.addEventListener(eventName, (event) => { event.preventDefault(); if (driveSubfolder) driveDrop.classList.add("is-dragging"); }));
      ["dragleave", "drop"].forEach((eventName) => driveDrop.addEventListener(eventName, (event) => { event.preventDefault(); driveDrop.classList.remove("is-dragging"); }));
      driveDrop.addEventListener("drop", async (event) => attachDriveFiles([...event.dataTransfer.files]));

      const localStudio = ["localhost", "127.0.0.1"].includes(location.hostname);
      if (localStudio) {
        renderCollectionButtons();
        setCollection("writeups");
      } else {
        $("studio-workspace").classList.add("studio-hosted");
        $("studio-bridge").hidden = false;
        $("save-status").textContent = "LOCAL ONLY";
      }
    </script>
  </body>
</html>
