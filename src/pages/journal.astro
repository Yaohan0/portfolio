---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'
const entries=(await getCollection('journal')).sort((a,b)=>
  b.data.date.localeCompare(a.data.date) || a.data.order - b.data.order
)
const groups=['Progress','Challenges','Reflections','Events']
const groupFor=(entry) => {
  const haystack=`${entry.data.title} ${entry.data.category} ${entry.data.tags.join(' ')}`.toLowerCase()
  if(/ctf|challenge|whitehacks|hackathon|capture the flag/.test(haystack)) return 'Challenges'
  if(/reflection|lesson|mistake|takeaway/.test(haystack)) return 'Reflections'
  if(/event|race|competition|pesta|milestone/.test(haystack)) return 'Events'
  return 'Progress'
}
const groupedEntries=entries.map(entry=>({entry,group:groupFor(entry)}))
const linkedInCount=entries.filter(entry=>Boolean(entry.data.linkedinUrl)).length
---
<Layout title="Journal — Yaohan"><main class="section-page journal-page"><Navbar current="Journal" />
  <header class="collection-hero journal-hero"><div><p class="collection-kicker">PROGRESS, CHALLENGES &amp; REFLECTIONS</p><h1>Journal</h1></div><div class="journal-note"><span>WHAT BELONGS HERE</span><p>Progress notes, reflections, events and selected LinkedIn posts from what I am learning and building. Finished technical solutions live under Writeups; class material lives under Notes.</p></div></header>
  <div class="journal-stats"><span>{entries.length} entries</span><span>{linkedInCount} linked to LinkedIn</span><span>2026 / ongoing</span></div>
  <nav class="logbook-filters" aria-label="Filter journal"><button class="active" type="button" data-log-filter="all">All</button>{groups.map(group=><button type="button" data-log-filter={group.toLowerCase()}>{group}</button>)}{linkedInCount>0 && <button type="button" data-log-filter="linkedin">LinkedIn</button>}</nav>
  <section class="journal-stack">{groupedEntries.map(({entry,group},index)=><a class="journal-entry" data-log-group={group.toLowerCase()} data-log-linkedin={entry.data.linkedinUrl ? 'true' : 'false'} href={withBase(`journal/${entry.data.slug}`)}>
    <div class="entry-index">{String(index+1).padStart(2,'0')}</div>
    <div class="entry-date">{entry.data.date}<span>{entry.data.mood}</span></div>
    <div class="entry-copy"><p>{group} · {entry.data.category}</p><h2>{entry.data.title}</h2><p>{entry.data.summary || 'A quick record of the work, decision, or lesson—open it for the full entry.'}</p><div>{entry.data.linkedinUrl && <span class="linkedin-tag">LinkedIn ↗</span>}{entry.data.tags.map(tag=><span>#{tag}</span>)}</div></div>
    {entry.data.cover && <img src={withBase(entry.data.cover)} alt={entry.data.title} loading="lazy" />}
    <span class="entry-plus">+</span></a>)}</section>
  <p class="logbook-empty" hidden>No journal entries in this view yet.</p>
  <script is:inline>
    const logButtons=[...document.querySelectorAll('[data-log-filter]')]; const logEntries=[...document.querySelectorAll('[data-log-group]')]; const logEmpty=document.querySelector('.logbook-empty');
    logButtons.forEach(button=>button.addEventListener('click',()=>{const group=button.dataset.logFilter;let shown=0;logButtons.forEach(item=>item.classList.toggle('active',item===button));logEntries.forEach(entry=>{const visible=group==='all'||entry.dataset.logGroup===group||(group==='linkedin'&&entry.dataset.logLinkedin==='true');entry.hidden=!visible;if(visible)shown+=1});logEmpty.hidden=shown>0;}));
  </script>
</main></Layout>
