---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'
const entries=(await getCollection('journal')).sort((a,b)=>a.data.order-b.data.order)
const categories=[...new Set(entries.map(entry=>entry.data.category))]
---
<Layout title="Journal — Yaohan"><main class="section-page journal-page"><Navbar current="Journal" />
  <header class="collection-hero journal-hero"><div><p class="collection-kicker">FIELD NOTES &amp; REFLECTIONS</p><h1>Journal</h1></div><div class="journal-note"><span>NOTE TO SELF</span><p>Writing makes the process visible. These are the rough edges, lessons, and working thoughts behind the finished result.</p></div></header>
  <div class="journal-stats"><span>{entries.length} entries</span><span>{categories.length} categories</span><span>2026 / ongoing</span></div>
  <section class="journal-stack">{entries.map((entry,index)=><a class="journal-entry" href={withBase(`journal/${entry.data.slug}`)}>
    <div class="entry-index">{String(index+1).padStart(2,'0')}</div>
    <div class="entry-date">{entry.data.date}<span>{entry.data.mood}</span></div>
    <div class="entry-copy"><p>{entry.data.category}</p><h2>{entry.data.title}</h2><p>{entry.data.summary || 'A working note from the archive—open the entry for the full record and supporting evidence.'}</p><div>{entry.data.tags.map(tag=><span>#{tag}</span>)}</div></div>
    {entry.data.cover && <img src={withBase(entry.data.cover)} alt={entry.data.title} loading="lazy" />}
    <span class="entry-plus">+</span></a>)}</section>
</main></Layout>
