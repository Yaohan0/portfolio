---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import { getCollection, render } from 'astro:content'
import { withBase } from '../../utils/paths'

export async function getStaticPaths() {
  const hobbies = await getCollection('hobbies')
  return hobbies.map((hobby) => ({ params: { slug: hobby.data.slug }, props: { hobby } }))
}

const { hobby } = Astro.props
const { Content } = await render(hobby)
---

<Layout title={`${hobby.data.title} — Yaohan`} description={hobby.data.summary}>
  <main class="hobby-detail" style={`--hobby-accent:${hobby.data.accent}`}>
    <Navbar current="Hobbies" />
    <header><a href={withBase('hobbies')}>← ALL HOBBIES</a><p>{hobby.data.category} / {hobby.data.status}</p><h1>{hobby.data.title}</h1><span>{hobby.data.context}</span></header>
    {hobby.data.cover && <img class="hobby-detail-cover" src={withBase(hobby.data.cover)} alt={`${hobby.data.title} featured image`} />}
    <section><article><Content /></article><aside><p>QUICK NOTES</p>{hobby.data.highlights.map((highlight) => <span>{highlight}</span>)}</aside></section>
  </main>
</Layout>
