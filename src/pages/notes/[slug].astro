---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import { getCollection, render } from 'astro:content'
import { withBase } from '../../utils/paths'
export async function getStaticPaths(){const notes=await getCollection('notes');return notes.map(note=>({params:{slug:note.data.slug},props:{note}}))}
const { note }=Astro.props
const { Content }=await render(note)
---
<Layout title={`${note.data.title} — Notes`} description={note.data.summary}><main class="note-detail"><Navbar current="Notes" />
  <header><a href={withBase('notes')}>← BACK TO SUBJECTS</a><div><span>{note.data.subject}</span><span>{note.data.status}</span><span>{note.data.date}</span></div><h1>{note.data.title}</h1><p>{note.data.summary}</p>{note.data.cover&&<img src={withBase(note.data.cover)} alt={note.data.title}/>}</header>
  <section><article><div class="note-paper"><Content /></div></article><aside><div><p>SUBJECT</p><strong>{note.data.subject}</strong></div><div><p>TAGS</p><div class="note-tags">{note.data.tags.map(tag=><span>#{tag}</span>)}</div></div><div><p>FILES</p>{note.data.files.length?note.data.files.map(file=><a href={withBase(file.url)}>{file.type} · {file.name} ↗</a>):<span>No files attached.</span>}</div></aside></section>
</main></Layout>
