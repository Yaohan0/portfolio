---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'

const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order)
const subjects = [
  { code: 'ECOMM', name: 'Effective Communication', color: '#ffc95c', desk: 'Communication' },
  { code: 'ENNK', name: 'Enterprise Networking', color: '#8edcff', desk: 'Networking' },
  { code: 'EHIP', name: 'Ethical Hacking & Intrusion Prevention', color: '#d6f26b', desk: 'Offensive security' },
  { code: 'FDS', name: 'Forensics in Digital Security', color: '#ff8ca0', desk: 'Digital forensics' },
  { code: 'SADS', name: 'Servers Administration & Security', color: '#bda7ff', desk: 'Infrastructure' },
]
---

<Layout title="Notes - Yaohan" description="Yaohan's structured cybersecurity and course notes.">
  <main class="notes-page">
    <Navbar current="Notes" />

    <section class="notes-desk-stage" style={`--desk-image: url('${withBase('notes-desk.png')}')`}>
      <div class="desk-shade" aria-hidden="true"></div>

      <div id="notes-workspace" class="notes-workspace" tabindex="0" aria-label="Notes workspace. Scroll or use arrow keys to change subject.">
        <header class="workspace-bar">
          <div class="workspace-identity">
            <span class="workspace-mark">Y.</span>
            <div><strong>Notes desk</strong><small>Yaohan's subject library</small></div>
          </div>
          <div class="workspace-status"><span></span> {subjects.length} SUBJECTS / {String(notes.length).padStart(2, '0')} FILES</div>
        </header>

        <div class="workspace-body">
          <nav class="subject-dock" aria-label="Note subjects">
            <p>SUBJECTS</p>
            {subjects.map((subject, index) => (
              <button
                type="button"
                class:list={['subject-tab', { active: index === 0 }]}
                data-subject-index={index}
                style={`--subject: ${subject.color}; --tab-index: ${index}`}
              >
                <span class="subject-folder" aria-hidden="true"><i></i></span>
                <span class="subject-tab-copy">
                  <small>{subject.code}</small>
                  <strong>{subject.name}</strong>
                </span>
                <em>{String(notes.filter((note) => note.data.subject === subject.code).length).padStart(2, '0')}</em>
              </button>
            ))}
          </nav>

          <section class="workspace-focus" aria-live="polite">
            <div class="focus-heading">
              <div><p>OPEN FOLDER</p><span id="active-subject-code">{subjects[0].code}</span></div>
              <span class="focus-counter" id="file-count">{notes.filter((note) => note.data.subject === subjects[0].code).length} FILE</span>
            </div>

            <div class="open-folder-card" style={`--subject: ${subjects[0].color}`} id="open-folder-card">
              <div class="open-folder-tab"></div>
              <small id="active-subject-desk">{subjects[0].desk}</small>
              <h1 id="active-subject-name">{subjects[0].name}</h1>
              <p>Course notes, references, screenshots and working files.</p>
            </div>

            <div id="notes-file-list" class="workspace-files">
              {notes.map((note, index) => (
                <a
                  href={withBase(`notes/${note.data.slug}`)}
                  class="workspace-file"
                  data-note-subject={note.data.subject}
                  hidden={note.data.subject !== subjects[0].code}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div><strong>{note.data.title}</strong><small>{note.data.summary}</small></div>
                  <time>{note.data.date}</time>
                  <b>OPEN</b>
                </a>
              ))}
              <div id="empty-notes" class="notes-empty" hidden>No notes here yet. Add the first one from Studio.</div>
            </div>
          </section>

          <aside class="workspace-info">
            <div class="workspace-info-top">
              <p>DESK INDEX</p>
              <span>LIVE</span>
            </div>
            <div class="mini-stack" aria-hidden="true">
              {subjects.map((subject, index) => <i style={`--subject:${subject.color};--mini-index:${index}`}></i>)}
            </div>
            <div class="workspace-meta">
              <span>ACTIVE</span><strong id="active-subject-meta">{subjects[0].code}</strong>
              <span>UPDATED</span><strong>{notes[0]?.data.date ?? '—'}</strong>
            </div>
            <p class="workspace-help"><kbd>SCROLL</kbd> or use arrow keys<br/>to move through folders.</p>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const workspace = document.getElementById('notes-workspace');
    const subjectTabs = [...document.querySelectorAll('[data-subject-index]')];
    const noteRows = [...document.querySelectorAll('[data-note-subject]')];
    const folderCard = document.getElementById('open-folder-card');
    const activeName = document.getElementById('active-subject-name');
    const activeCode = document.getElementById('active-subject-code');
    const activeDesk = document.getElementById('active-subject-desk');
    const activeMeta = document.getElementById('active-subject-meta');
    const fileCount = document.getElementById('file-count');
    const empty = document.getElementById('empty-notes');
    const subjectData = [...document.querySelectorAll('.subject-tab')].map((tab) => ({
      code: tab.querySelector('small').textContent,
      name: tab.querySelector('strong').textContent,
      color: getComputedStyle(tab).getPropertyValue('--subject').trim(),
      desk: ['Communication', 'Networking', 'Offensive security', 'Digital forensics', 'Infrastructure'][Number(tab.dataset.subjectIndex)],
    }));
    let active = 0;
    let wheelLocked = false;
    let touchStartX = 0;

    const wrap = (value) => (value + subjectTabs.length) % subjectTabs.length;
    const selectSubject = (next) => {
      active = wrap(next);
      const current = subjectData[active];
      subjectTabs.forEach((tab, index) => tab.classList.toggle('active', index === active));
      activeName.textContent = current.name;
      activeCode.textContent = current.code;
      activeDesk.textContent = current.desk;
      activeMeta.textContent = current.code;
      folderCard.style.setProperty('--subject', current.color);
      let shown = 0;
      noteRows.forEach((row) => {
        const visible = row.dataset.noteSubject === current.code;
        row.hidden = !visible;
        if (visible) shown += 1;
      });
      fileCount.textContent = `${shown} FILE${shown === 1 ? '' : 'S'}`;
      empty.hidden = shown !== 0;
    };

    subjectTabs.forEach((tab, index) => tab.addEventListener('click', () => selectSubject(index)));
    workspace?.addEventListener('keydown', (event) => {
      if (['ArrowRight', 'ArrowDown'].includes(event.key)) { event.preventDefault(); selectSubject(active + 1); }
      if (['ArrowLeft', 'ArrowUp'].includes(event.key)) { event.preventDefault(); selectSubject(active - 1); }
    });
    workspace?.addEventListener('wheel', (event) => {
      if (!matchMedia('(pointer:fine)').matches || event.target.closest('.workspace-files')) return;
      event.preventDefault();
      if (wheelLocked) return;
      wheelLocked = true;
      selectSubject(active + (event.deltaY > 0 ? 1 : -1));
      setTimeout(() => wheelLocked = false, 240);
    }, { passive: false });
    workspace?.addEventListener('touchstart', (event) => touchStartX = event.touches[0].clientX, { passive: true });
    workspace?.addEventListener('touchend', (event) => {
      const delta = touchStartX - event.changedTouches[0].clientX;
      if (Math.abs(delta) > 45) selectSubject(active + (delta > 0 ? 1 : -1));
    }, { passive: true });

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer:fine)').matches) {
      workspace?.addEventListener('pointermove', (event) => {
        const rect = workspace.getBoundingClientRect();
        workspace.style.setProperty('--desk-ry', `${((event.clientX - rect.left) / rect.width - .5) * 1.4}deg`);
        workspace.style.setProperty('--desk-rx', `${(.5 - (event.clientY - rect.top) / rect.height) * 1.1}deg`);
        workspace.style.setProperty('--light-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        workspace.style.setProperty('--light-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
      workspace?.addEventListener('pointerleave', () => {
        workspace.style.setProperty('--desk-ry', '0deg');
        workspace.style.setProperty('--desk-rx', '0deg');
      });
    }
  </script>
</Layout>
