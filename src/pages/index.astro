---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { withBase } from '../utils/paths'

const records = [
  { no: '01', title: 'Journal', href: '/journal', type: 'FIELD NOTES', desc: 'Reflections, mistakes, progress logs, and the stories behind what I am learning.' },
  { no: '02', title: 'Labs', href: '/labs', type: 'PRACTICE', desc: 'Hands-on ethical hacking, networking, cloud, Linux, and digital forensics work.' },
  { no: '03', title: 'Writeups', href: '/writeups', type: 'CTF RECORDS', desc: 'Challenge solutions across web, forensics, crypto, reverse engineering, pwn, and misc.' },
  { no: '04', title: 'Achievements', href: '/achievements', type: 'MILESTONES', desc: 'Certifications, awards, competitions, school milestones, and completed goals.' },
  { no: '05', title: 'Skills', href: '/skills', type: 'TOOLKIT', desc: 'A living tracker of tools, techniques, topics, and what I am currently learning.' },
  { no: '06', title: 'Archive', href: '/archive', type: 'DOCUMENTS', desc: 'Older notes, screenshots, experiments, references, drafts, and documentation.' },
]
---

<Layout title="Yaohan Wang — Cybersecurity Portfolio">
  <main class="portfolio-shell">
    <Navbar current="Home" />

    <section class="hero" aria-labelledby="hero-title">
      <div class="star-field" aria-hidden="true"></div>
      <div class="hero-inner">
        <p class="eyebrow">— Portfolio · 2026 · Cybersecurity</p>
        <h1 id="hero-title"><span>Yaohan</span><span>Wang</span></h1>
        <p class="role-line">I’m a cybersecurity student<span class="cursor">_</span></p>
        <p class="hero-copy">Year 2 Cybersecurity &amp; Digital Forensics student at Temasek Polytechnic, Singapore. I document labs, CTF attempts, forensics notes, school projects, and the technical lessons worth keeping.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#records">Explore my work <span>↘</span></a>
          <a class="button button-ghost" href={withBase('achievements')}>View achievements</a>
        </div>
        <div class="hero-meta">
          <a href="mailto:2503587D@student.tp.edu.sg">2503587D@student.tp.edu.sg</a>
          <span>GitHub / Yaohan0</span><span>Discord / yaooohann</span>
        </div>
      </div>
      <div class="scroll-note">SCROLL <span>↓</span></div>
    </section>

    <section class="index-strip" aria-label="Portfolio overview">
      <div><strong>06</strong><span>Sections</span></div><div><strong>02</strong><span>Study year</span></div><div><strong>SG</strong><span>Based in</span></div><div><strong>∞</strong><span>Still learning</span></div>
    </section>

    <section id="records" class="records-section">
      <div class="section-heading">
        <div><p>SHEET 02 — INDEX OF WORK</p><h2>Things I’ve<br/><em>documented</em></h2></div>
        <p class="section-intro">A growing field archive of practical work, technical notes, milestones, and experiments.</p>
      </div>
      <div class="records-grid">
        {records.map((record) => (
          <a class="record-card" href={withBase(record.href)}>
            <div class="record-top"><span>{record.type}</span><span>REF-2026-{record.no}</span></div>
            <div class="record-number">{record.no}</div>
            <h3>{record.title}</h3><p>{record.desc}</p>
            <div class="record-open">OPEN RECORD <span>↗</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="about-section">
      <p class="stamp">IN PROGRESS</p>
      <div><p class="eyebrow">— Current field position</p><h2>Learning in public.<br/>Keeping the evidence.</h2></div>
      <div class="about-copy"><p>This site is my working record—not a finished story. It keeps the useful material together so I can trace how my thinking, methods, and technical ability change over time.</p><p>Current focus: ethical hacking, digital forensics, networking, cloud foundations, Linux, and CTF problem-solving.</p></div>
    </section>

    <section class="game-section" aria-labelledby="game-title">
      <div class="game-heading"><p>OPTIONAL SIDE QUEST / 30 SEC</p><h2 id="game-title">Firewall<br/><span>Frenzy</span></h2><p>Threats are crossing the network. Block malicious packets, let legitimate traffic through, and keep the system online.</p></div>
      <div class="game-console">
        <div class="game-bar"><span>YH DEFENCE CONSOLE</span><div><span>SCORE <b id="game-score">0000</b></span><span>INTEGRITY <b id="game-lives">●●●</b></span><span>TIME <b id="game-time">30</b></span></div></div>
        <div id="packet-field" class="packet-field" aria-live="polite"><div class="game-idle"><strong>READY?</strong><p>Block <i>MALICIOUS</i> packets. Ignore safe traffic.</p></div></div>
        <div class="game-controls"><div class="game-legend"><span><i class="safe-dot"></i>SAFE — let pass</span><span><i class="threat-dot"></i>THREAT — click to block</span></div><button id="game-start" type="button">START DEFENCE ↗</button></div>
      </div>
    </section>

    <footer class="portfolio-footer">
      <p class="footer-mark">YH.</p><h2>Let’s talk.</h2><p>Open to conversations about cybersecurity, student projects, CTFs, and opportunities to learn by building.</p>
      <a class="footer-email" href="mailto:2503587D@student.tp.edu.sg">2503587D@student.tp.edu.sg ↗</a>
      <div class="footer-bottom"><span>© 2026 Yaohan Wang</span><span>Temasek Polytechnic · Singapore</span><span>Built with care</span></div>
    </footer>
  </main>

  <script is:inline>
    const field=document.getElementById('packet-field');const start=document.getElementById('game-start');const scoreNode=document.getElementById('game-score');const livesNode=document.getElementById('game-lives');const timeNode=document.getElementById('game-time');
    const threats=['SQLi','XSS','RAT','PHISH','MAL'];const safe=['HTTPS','DNS','SSH','TLS','NTP'];let score=0,lives=3,time=30,running=false,spawnTimer,countTimer;
    const updateGame=()=>{scoreNode.textContent=String(score).padStart(4,'0');livesNode.textContent='●'.repeat(Math.max(0,lives))+'○'.repeat(Math.max(0,3-lives));timeNode.textContent=time};
    const endGame=()=>{running=false;clearInterval(spawnTimer);clearInterval(countTimer);field.querySelectorAll('.packet').forEach(p=>p.remove());field.innerHTML=`<div class="game-idle"><strong>${lives>0?'SYSTEM SECURED':'BREACH DETECTED'}</strong><p>Final score: ${score}. ${score>=700?'Sharp response.':score>=300?'Good start—try another run.':'The firewall needs another operator.'}</p></div>`;start.textContent='PLAY AGAIN ↗'};
    const loseLife=()=>{if(!running)return;lives--;updateGame();if(lives<=0)endGame()};
    const spawnPacket=()=>{if(!running)return;const malicious=Math.random()<.48;const packet=document.createElement('button');packet.type='button';packet.className=`packet ${malicious?'threat':'safe'}`;packet.textContent=(malicious?threats:safe)[Math.floor(Math.random()*5)];packet.style.setProperty('--lane',Math.floor(Math.random()*5));packet.style.setProperty('--speed',`${4+Math.random()*3}s`);packet.setAttribute('aria-label',`${malicious?'Threat':'Safe'} packet ${packet.textContent}`);packet.addEventListener('click',()=>{if(malicious){score+=100;packet.classList.add('blocked');setTimeout(()=>packet.remove(),220)}else{score=Math.max(0,score-50);packet.classList.add('wrong');loseLife()}updateGame()});packet.addEventListener('animationend',()=>{if(malicious&&!packet.classList.contains('blocked'))loseLife();packet.remove()});field.append(packet)};
    start?.addEventListener('click',()=>{score=0;lives=3;time=30;running=true;field.innerHTML='';start.textContent='DEFENDING...';updateGame();spawnPacket();spawnTimer=setInterval(spawnPacket,700);countTimer=setInterval(()=>{time--;updateGame();if(time<=0)endGame()},1000)});
  </script>
</Layout>
