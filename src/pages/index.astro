---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { withBase } from '../utils/paths'

const records = [
  { no: '01', title: 'Journal', href: '/journal', type: 'FIELD NOTES', desc: 'Reflections, mistakes, progress logs, and the stories behind what I am learning.' },
  { no: '02', title: 'Notes', href: '/notes', type: 'SUBJECT LIBRARY', desc: 'Structured course notes for ECOMM, ENNK, EHIP, FDS, and SADS.' },
  { no: '03', title: 'Labs', href: '/labs', type: 'PRACTICE', desc: 'Hands-on ethical hacking, networking, cloud, Linux, and digital forensics work.' },
  { no: '04', title: 'Writeups', href: '/writeups', type: 'CTF RECORDS', desc: 'Challenge solutions across web, forensics, crypto, reverse engineering, pwn, and misc.' },
  { no: '05', title: 'Achievements', href: '/achievements', type: 'MILESTONES', desc: 'Certifications, awards, competitions, school milestones, and completed goals.' },
  { no: '06', title: 'Skills', href: '/skills', type: 'TOOLKIT', desc: 'A living tracker of tools, techniques, topics, and what I am currently learning.' },
  { no: '07', title: 'Archive', href: '/archive', type: 'DOCUMENTS', desc: 'Older notes, screenshots, experiments, references, drafts, and documentation.' },
]
const projectRecords = records.filter((record) => record.title !== 'Archive')
const archiveRecord = records.find((record) => record.title === 'Archive')
const focusAreas = [
  { title: 'Ethical hacking', items: ['Web exploitation', 'Enumeration', 'CTF problem-solving'] },
  { title: 'Digital forensics', items: ['Evidence handling', 'File analysis', 'Steganography'] },
  { title: 'Networking', items: ['VLANs', 'EtherChannel', 'Server administration'] },
  { title: 'Working habits', items: ['Documentation', 'Reflection', 'Communication'] },
]
---

<Layout title="Yaohan — Cybersecurity Portfolio">
  <main class="portfolio-shell home-clean">
    <Navbar current="Home" />

    <section class="reference-hero" aria-labelledby="hero-title">
      <div class="reference-intro">
        <p>Hey! I’m Yaohan <span aria-hidden="true">👋</span></p>
        <h1 id="hero-title">Cybersecurity &amp;<br/><em>Digital Forensics</em><br/>student.</h1>
        <small>Learning through labs, CTFs and evidence.</small>
        <a href="#records">TAKE A LOOK <span>↓</span></a>
      </div>
      <div class="reference-portrait" role="img" aria-label="Space reserved for Yaohan's future portrait">
        <span>PHOTO COMING SOON</span>
        <div aria-hidden="true"><i></i></div>
        <small>Temasek Polytechnic · Singapore</small>
      </div>
    </section>

    <section id="records" class="reference-projects">
      <h2>Some projects<span>.</span></h2>
      <div class="reference-project-grid">
        {projectRecords.map((record, index) => (
          <a class={`reference-project-card project-${index + 1}`} href={withBase(record.href)}>
            <div class="project-preview" aria-hidden="true">
              <span>{record.no}</span><strong>{record.title.slice(0, 1)}</strong><i></i><i></i>
            </div>
            <div class="project-card-copy"><h3>{record.title}</h3><p>{record.desc}</p><div><span>{record.type}</span><span>2026</span></div></div>
          </a>
        ))}
        {archiveRecord && <a class="reference-project-wide" href={withBase(archiveRecord.href)}><div><strong>{archiveRecord.title}</strong><p>{archiveRecord.desc}</p></div><span>OPEN ARCHIVE ↗</span></a>}
      </div>
    </section>

    <section class="reference-story">
      <h2>My story<span>.</span></h2>
      <div>
        <p>I’m a Year 2 Cybersecurity &amp; Digital Forensics student at Temasek Polytechnic. I started this portfolio to keep a clear record of the work behind the grades—setups, mistakes, evidence, findings and improvements.</p>
        <p>Most of my learning happens through practical labs, CTF challenges and documenting what I find. The goal is simple: understand systems properly, explain them clearly, and get better with every attempt.</p>
        <p>I’m currently exploring ethical hacking, digital forensics, networking, Linux and server security.</p>
      </div>
    </section>

    <section class="reference-focus">
      <h2>Current focus<span>.</span></h2>
      <div>{focusAreas.map((area) => <section><h3>{area.title}</h3>{area.items.map((item) => <p>{item}</p>)}</section>)}</div>
    </section>

    <section class="game-section" aria-labelledby="game-title">
      <div class="game-heading"><p>OPTIONAL SIDE QUEST / 45 SEC</p><h2 id="game-title">Arc<br/><span>Rush</span></h2><p>Shoot around the entire three-point line. Hold the mouse to build power, release inside the thin green window, and score as quickly as possible.</p></div>
      <div class="game-console basketball-game">
        <div class="game-bar"><span>YH THREE-POINT LAB</span><div><span>PTS <b id="game-score">00</b></span><span>MADE <b id="game-made">0/0</b></span><span>TIME <b id="game-time">45</b></span></div></div>
        <div id="shot-stage" class="shot-stage">
          <canvas id="hoop-canvas" width="900" height="520" aria-label="Top-down basketball three-point shooting game">Your browser does not support the basketball game.</canvas>
          <div id="game-overlay" class="game-overlay"><strong>ARC RUSH</strong><p>Hold anywhere on the court or the shoot button. Release in the thin green zone.</p></div>
          <div id="shot-callout" class="shot-callout" aria-live="polite">HOLD TO CHARGE</div>
        </div>
        <div class="shot-controls">
          <div class="power-module"><div class="power-label"><span>SHOT POWER</span><b id="power-readout">00%</b></div><div class="power-track"><div id="power-needle" class="power-needle"></div></div><div class="power-key"><span>LOW</span><span>PERFECT</span><span>HIGH</span></div></div>
          <button id="shoot-button" type="button" disabled>HOLD TO SHOOT</button>
          <button id="game-start" type="button">START 45 SEC ↗</button>
        </div>
      </div>
    </section>

    <footer class="portfolio-footer">
      <p class="footer-mark">YH.</p><h2>Let’s talk.</h2><p>Open to conversations about cybersecurity, student projects, CTFs, and opportunities to learn by building.</p>
      <a class="footer-email" href="mailto:2503587D@student.tp.edu.sg">2503587D@student.tp.edu.sg ↗</a>
      <div class="footer-bottom"><span>© 2026 Yaohan</span><span>Temasek Polytechnic · Singapore</span><span>Built with care</span></div>
    </footer>
  </main>

  <script is:inline>
    const canvas=document.getElementById('hoop-canvas');const ctx=canvas?.getContext('2d');const stage=document.getElementById('shot-stage');const start=document.getElementById('game-start');const shootButton=document.getElementById('shoot-button');const scoreNode=document.getElementById('game-score');const madeNode=document.getElementById('game-made');const timeNode=document.getElementById('game-time');const overlay=document.getElementById('game-overlay');const callout=document.getElementById('shot-callout');const needle=document.getElementById('power-needle');const powerReadout=document.getElementById('power-readout');
    const angles=[155,132,112,90,68,48,25];let angleIndex=0,score=0,makes=0,attempts=0,time=45,running=false,charging=false,animating=false,chargeStart=0,power=0,countTimer,chargeFrame,shotFrame,ball=null;
    const shooter=()=>{const angle=angles[angleIndex]*Math.PI/180;return{x:450+Math.cos(angle)*330,y:102+Math.sin(angle)*330}};
    const drawCourt=()=>{if(!ctx)return;ctx.clearRect(0,0,900,520);const bg=ctx.createLinearGradient(0,0,0,520);bg.addColorStop(0,'#171318');bg.addColorStop(1,'#09090d');ctx.fillStyle=bg;ctx.fillRect(0,0,900,520);ctx.strokeStyle='rgba(244,167,73,.23)';ctx.lineWidth=2;for(let y=34;y<520;y+=34){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(900,y);ctx.stroke()}ctx.strokeStyle='rgba(244,243,239,.42)';ctx.lineWidth=3;ctx.beginPath();ctx.arc(450,102,330,Math.PI*.14,Math.PI*.86);ctx.stroke();ctx.strokeRect(358,0,184,176);ctx.beginPath();ctx.arc(450,176,70,0,Math.PI);ctx.stroke();ctx.strokeStyle='#d8ff55';ctx.lineWidth=5;ctx.beginPath();ctx.ellipse(450,96,29,10,0,0,Math.PI*2);ctx.stroke();ctx.strokeStyle='rgba(244,243,239,.65)';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(398,70);ctx.lineTo(502,70);ctx.stroke();const p=shooter();ctx.fillStyle='rgba(216,255,85,.13)';ctx.beginPath();ctx.arc(p.x,p.y,29,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#d8ff55';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#d8ff55';ctx.font='700 12px JetBrains Mono';ctx.textAlign='center';ctx.fillText('YOU',p.x,p.y+4);ctx.fillStyle='rgba(244,243,239,.32)';ctx.font='700 10px JetBrains Mono';ctx.fillText(`SPOT ${angleIndex+1}/7`,p.x,p.y+47);if(ball){ctx.fillStyle='rgba(0,0,0,.28)';ctx.beginPath();ctx.ellipse(ball.x+7,ball.y+12,ball.size*.75,ball.size*.28,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#f29a38';ctx.beginPath();ctx.arc(ball.x,ball.y,ball.size,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#5c2f12';ctx.lineWidth=2;ctx.stroke();ctx.beginPath();ctx.moveTo(ball.x-ball.size,ball.y);ctx.lineTo(ball.x+ball.size,ball.y);ctx.stroke();ctx.beginPath();ctx.arc(ball.x,ball.y,ball.size*.55,-Math.PI/2,Math.PI/2);ctx.stroke();}ctx.textAlign='start'};
    const setPower=value=>{power=Math.max(0,Math.min(100,value));needle.style.left=`${power}%`;powerReadout.textContent=`${Math.round(power)}%`;const state=power>=48&&power<=52?'perfect':power>=38&&power<=62?'chance':'miss';needle.dataset.zone=state;callout.textContent=state==='perfect'?'PERFECT WINDOW':state==='chance'?'MAKEABLE':'OUT OF RANGE'};
    const chargeLoop=now=>{if(!charging)return;const cycle=((now-chargeStart)%1500)/1500;setPower(cycle<.5?cycle*200:(1-cycle)*200);chargeFrame=requestAnimationFrame(chargeLoop)};
    const beginCharge=event=>{if(!running||animating||charging)return;event?.preventDefault();charging=true;chargeStart=performance.now();callout.classList.add('active');chargeFrame=requestAnimationFrame(chargeLoop)};
    const releaseShot=event=>{if(!charging)return;event?.preventDefault();charging=false;cancelAnimationFrame(chargeFrame);callout.classList.remove('active');shoot(power)};
    const shoot=shotPower=>{animating=true;attempts++;const perfect=shotPower>=48&&shotPower<=52;const orange=shotPower>=38&&shotPower<=62;const chance=perfect?1:orange?Math.max(.28,.78-Math.abs(50-shotPower)*.06):.03;const made=Math.random()<chance;const from=shooter();const missDirection=shotPower<50?-1:1;const to={x:450+(made?0:missDirection*(30+Math.abs(50-shotPower)*2.4)),y:96+(made?0:12)};const control={x:(from.x+to.x)/2,y:Math.min(from.y,to.y)-170};const startAt=performance.now();const animate=now=>{const t=Math.min(1,(now-startAt)/720);const u=1-t;ball={x:u*u*from.x+2*u*t*control.x+t*t*to.x,y:u*u*from.y+2*u*t*control.y+t*t*to.y,size:13+Math.sin(Math.PI*t)*8};drawCourt();if(t<1){shotFrame=requestAnimationFrame(animate)}else{if(made){makes++;score+=3;callout.textContent=perfect?'PERFECT · +3':'SPLASH · +3';callout.dataset.result='make'}else{callout.textContent=orange?'OFF RIM':'AIRBALL';callout.dataset.result='miss'}scoreNode.textContent=String(score).padStart(2,'0');madeNode.textContent=`${makes}/${attempts}`;ball=null;setTimeout(()=>{angleIndex=(angleIndex+1)%angles.length;animating=false;setPower(0);callout.textContent=running?'HOLD TO CHARGE':'TIME';delete callout.dataset.result;drawCourt()},310)}};shotFrame=requestAnimationFrame(animate)};
    const endGame=()=>{running=false;charging=false;animating=false;clearInterval(countTimer);cancelAnimationFrame(chargeFrame);cancelAnimationFrame(shotFrame);shootButton.disabled=true;overlay.hidden=false;overlay.innerHTML=`<strong>${score} POINTS</strong><p>${makes}/${attempts} made · ${makes>=10?'Elite pace.':makes>=5?'Good rhythm—run it back.':'Find the green window and fire faster.'}</p>`;start.textContent='PLAY AGAIN ↗';ball=null;drawCourt()};
    const startGame=()=>{score=0;makes=0;attempts=0;time=45;angleIndex=0;running=true;animating=false;charging=false;scoreNode.textContent='00';madeNode.textContent='0/0';timeNode.textContent='45';overlay.hidden=true;shootButton.disabled=false;start.textContent='RESTART';setPower(0);drawCourt();clearInterval(countTimer);countTimer=setInterval(()=>{time--;timeNode.textContent=String(time);if(time<=0)endGame()},1000)};
    [stage,shootButton].forEach(target=>{target?.addEventListener('pointerdown',beginCharge);target?.addEventListener('pointerup',releaseShot);target?.addEventListener('pointercancel',releaseShot);target?.addEventListener('pointerleave',event=>{if(charging)releaseShot(event)})});shootButton?.addEventListener('keydown',event=>{if((event.code==='Space'||event.code==='Enter')&&!event.repeat)beginCharge(event)});shootButton?.addEventListener('keyup',event=>{if(event.code==='Space'||event.code==='Enter')releaseShot(event)});start?.addEventListener('click',startGame);drawCourt();
  </script>
</Layout>
