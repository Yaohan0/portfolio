---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getCollection } from 'astro:content'
import { withBase } from '../utils/paths'

const profileEntries = (await getCollection('profile')).sort((a, b) => a.data.order - b.data.order)
const profile = profileEntries[0]?.data ?? {
  name: 'Yaohan',
  role: 'Cybersecurity & Digital Forensics student',
  location: 'Singapore',
  timezone: 'Asia/Singapore',
  latitude: 1.3521,
  longitude: 103.8198,
  temperatureUnit: 'celsius',
  status: 'Online',
  statusMessage: 'Learning, training and building.',
  cover: '/profile/yaohan-kayak-hero.png',
}
const presence = profile.status.toLowerCase()

const records = [
  { no: '01', key: 'logbook', title: 'Logbook', href: '/journal', type: 'PROGRESS LOG', desc: 'Short updates from projects, competitions, training, mistakes, and lessons in progress.' },
  { no: '02', key: 'notes', title: 'Notes', href: '/notes', type: 'CLASS LIBRARY', desc: 'The working home for everything I capture in class, organised by subject and folder.' },
  { no: '03', key: 'labs', title: 'Labs', href: '/labs', type: 'PRACTICE', desc: 'Hands-on ethical hacking, networking, cloud, Linux, and digital forensics work.' },
  { no: '04', key: 'writeups', title: 'Projects + Writeups', href: '/writeups', type: 'BUILDS & RECORDS', desc: 'Built projects, technical decisions, and finished challenge solutions with the method documented.' },
  { no: '05', key: 'achievements', title: 'Achievements', href: '/achievements', type: 'MILESTONES', desc: 'Certifications, awards, competitions, school milestones, and completed goals.' },
  { no: '06', key: 'skills', title: 'Skills', href: '/skills', type: 'TOOLKIT', desc: 'A living tracker of tools, techniques, topics, and what I am currently learning.' },
  { no: '07', key: 'archive', title: 'Archive', href: '/archive', type: 'STORAGE', desc: 'Older exports, references, experiments, media, and anything kept outside active class notes.' },
]
const projectRecords = records.filter((record) => record.title !== 'Archive')
const secondaryRecords = records.filter((record) => record.title === 'Archive')
const focusAreas = [
  { title: 'Ethical hacking', items: ['Web exploitation', 'Enumeration', 'CTF problem-solving'] },
  { title: 'Digital forensics', items: ['Evidence handling', 'File analysis', 'Steganography'] },
  { title: 'Networking', items: ['VLANs', 'EtherChannel', 'Server administration'] },
  { title: 'Working habits', items: ['Documentation', 'Reflection', 'Communication'] },
]
---

<Layout title="Yaohan — Cybersecurity Portfolio">
  <div class="entry-loader world-entry" data-entry-loader data-state="loading" role="dialog" aria-modal="true" aria-labelledby="entry-title">
    <div class="world-entry__texture" aria-hidden="true"></div>
    <header class="world-entry__header">
      <div><strong>YH</strong></div>
      <p>Singapore · World 2026</p>
    </header>

    <section class="world-entry__generator">
      <h1 id="entry-title" class="sr-only">Loading Yaohan’s portfolio world</h1>
      <div class="world-entry__percentage" aria-live="polite"><span data-loader-count>0</span>%</div>
      <div class="world-entry__map" data-world-map>
        <canvas width="288" height="288" data-world-canvas aria-hidden="true"></canvas>
        <span class="world-entry__scan" aria-hidden="true"></span>
      </div>
      <p class="world-entry__status" data-loader-status>Preparing spawn area...</p>
      <button class="world-entry__enter" type="button" data-loader-enter disabled>
        <span>Enter World</span><i aria-hidden="true">›</i>
      </button>
    </section>

  </div>
  <noscript><style>.entry-loader{display:none!important}</style></noscript>

  <main class="portfolio-shell home-clean">
    <Navbar current="Home" />

    <section
      class="profile-hero"
      aria-labelledby="hero-title"
      data-latitude={profile.latitude}
      data-longitude={profile.longitude}
      data-timezone={profile.timezone}
      data-temperature-unit={profile.temperatureUnit}
    >
      <div class="profile-grid" aria-hidden="true"></div>
      <div class="profile-location">
        <span>LIVE FROM {profile.location.toUpperCase()}</span>
        <strong><time id="sg-time">Singapore time</time></strong>
        <b id="sg-temp">Loading weather</b>
      </div>

      <div class="profile-copy">
        <p class="profile-handle typing-line" data-copy="Hi, I’m Yaooohann."><span>Hi, I’m {profile.name}.</span></p>
        <h1 id="hero-title">{profile.name}<em aria-hidden="true">/</em></h1>
        <p class="profile-role">{profile.role}</p>
        <p class="profile-intro">Year 2 Cybersecurity &amp; Digital Forensics student at Temasek Polytechnic, focused on ethical hacking, digital forensics, networking and server security. This is where I document the practical work, mistakes and progress behind what I learn.</p>
        <div class="profile-facts" aria-label="Current profile highlights">
          <span>Temasek Polytechnic</span>
          <span>Cybersecurity &amp; Forensics</span>
          <span>TP Kayak Racing</span>
        </div>
        <div class="profile-actions">
          <a class="profile-primary" href="#records">Explore my work <span aria-hidden="true">↘</span></a>
          <a href={withBase('/achievements')}>Milestones <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/yaohan-wang-a22951363/" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
        <p class="profile-status-message">
          <span class:list={['profile-presence', presence]} aria-hidden="true"><i></i></span>
          <strong>{profile.status}</strong>
          <span>{profile.statusMessage}</span>
        </p>
      </div>

      <figure class="profile-visual">
        {profile.cover && <img class="profile-portrait" src={withBase(profile.cover)} alt={`${profile.name} kayaking during race training`} />}
        <figcaption><span>TP KAYAK RACING</span><span>Pesta Sukan | 2026</span></figcaption>
        <span class="float-icon float-icon--shield" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 8 7 10 4.2-2 7-5.4 7-10V6l-7-3Z"/><path d="m9.5 12 1.7 1.7 3.6-4"/></svg>
        </span>
        <span class="float-icon float-icon--code" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/></svg>
        </span>
        <span class="float-icon float-icon--paddle" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m5 19 14-14M4 20c-1-1-1-3 0-4l3-3 4 4-3 3c-1 1-3 1-4 0ZM20 4c1 1 1 3 0 4l-3 3-4-4 3-3c1-1 3-1 4 0Z"/></svg>
        </span>
      </figure>

      <div class="profile-scroll" aria-hidden="true"><span>SCROLL TO EXPLORE</span><i></i></div>
    </section>

    <script is:inline>
      (() => {
        const hero = document.querySelector('.profile-hero');
        const timeNode = document.getElementById('sg-time');
        const tempNode = document.getElementById('sg-temp');
        if (!hero || !timeNode || !tempNode) return;

        const timezone = hero.dataset.timezone || 'Asia/Singapore';
        const latitude = hero.dataset.latitude || '1.3521';
        const longitude = hero.dataset.longitude || '103.8198';
        const temperatureUnit = hero.dataset.temperatureUnit === 'fahrenheit' ? 'fahrenheit' : 'celsius';
        const unitSymbol = temperatureUnit === 'fahrenheit' ? '°F' : '°C';
        const clock = new Intl.DateTimeFormat('en-SG', {
          timeZone: timezone,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
        const updateClock = () => { timeNode.textContent = `${clock.format(new Date())} SGT`; };
        updateClock();
        setInterval(updateClock, 1000);

        const endpoint = `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(latitude)}&longitude=${encodeURIComponent(longitude)}&current=temperature_2m&temperature_unit=${temperatureUnit}`;
        fetch(endpoint)
          .then((response) => {
            if (!response.ok) throw new Error('Weather request failed');
            return response.json();
          })
          .then((weather) => {
            const value = weather?.current?.temperature_2m;
            tempNode.textContent = Number.isFinite(value) ? `${Math.round(value)}${unitSymbol}` : 'Weather unavailable';
          })
          .catch(() => { tempNode.textContent = 'Weather unavailable'; });

        const typingLine = hero.querySelector('.typing-line');
        if (typingLine) {
          const output = typingLine.querySelector('span');
          const phrases = ['Hi, I’m Yaohan.', 'Hi, I’m Yaooohann.'];
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            output.textContent = phrases[0];
          } else {
            let phraseIndex = 0;
            let characterIndex = 0;
            let deleting = false;
            let started = false;
            output.textContent = '';
            const typeNext = () => {
              const phrase = phrases[phraseIndex];
              typingLine.classList.add('is-typing');
              characterIndex += deleting ? -1 : 1;
              output.textContent = phrase.slice(0, Math.max(0, characterIndex));
              if (!deleting && characterIndex === phrase.length) {
                typingLine.classList.remove('is-typing');
                deleting = true;
                setTimeout(typeNext, 1300);
                return;
              }
              if (deleting && characterIndex === 0) {
                deleting = false;
                phraseIndex = (phraseIndex + 1) % phrases.length;
                setTimeout(typeNext, 320);
                return;
              }
              setTimeout(typeNext, deleting ? 34 : 52 + Math.random() * 34);
            };
            const startTyping = () => {
              if (started) return;
              started = true;
              setTimeout(typeNext, 220);
            };
            window.addEventListener('portfolio:entered', startTyping, { once: true });
          }
        }
      })();
    </script>

    <section id="records" class="reference-projects">
      <h2>Some projects<span>.</span></h2>
      <div class="reference-project-grid">
        {projectRecords.map((record, index) => (
          <a class={`reference-project-card project-${index + 1}`} data-project={record.key} href={withBase(record.href)}>
            <div class="project-preview" aria-hidden="true">
              <span>{record.no}</span>
              {record.key === 'logbook' && <div class="project-symbol symbol-logbook"><i></i><i></i><i></i><b></b></div>}
              {record.key === 'notes' && <div class="project-symbol symbol-notes"><i></i><i></i><i></i></div>}
              {record.key === 'labs' && <div class="project-symbol symbol-labs"><b></b><i></i><i></i><i></i></div>}
              {record.key === 'writeups' && <div class="project-symbol symbol-writeups"><b>&gt;_</b><i></i><i></i></div>}
              {record.key === 'achievements' && <div class="project-symbol symbol-achievements"><b></b>{Array.from({ length: 8 }).map(() => <i></i>)}</div>}
              {record.key === 'skills' && <div class="project-symbol symbol-skills"><b></b><i></i><i></i><i></i><i></i></div>}
            </div>
            <div class="project-card-copy"><h3>{record.title}</h3><p>{record.desc}</p><div><span>{record.type}</span><span>2026</span></div></div>
          </a>
        ))}
        {secondaryRecords.map((record) => <a class="reference-project-wide" href={withBase(record.href)}><div class="archive-symbol" aria-hidden="true"><i></i><i></i><i></i></div><div><strong>{record.title}</strong><p>{record.desc}</p></div><span>OPEN {record.title.toUpperCase()} ↗</span></a>)}
      </div>
    </section>

    <section class="reference-story">
      <h2>My story<span>.</span></h2>
      <div>
        <p>I’m a Year 2 Cybersecurity &amp; Digital Forensics student at Temasek Polytechnic. I started this portfolio to keep a clear record of the work behind the grades—setups, mistakes, evidence, findings and improvements.</p>
        <p>Most of my learning happens through practical labs, CTF challenges and documenting what I find. The goal is simple: understand systems properly, explain them clearly, and get better with every attempt.</p>
        <p>I’m currently exploring ethical hacking, digital forensics, networking, Linux and server security.</p>
      </div>
    </section>

    <section class="reference-focus">
      <h2>Current focus<span>.</span></h2>
      <div>{focusAreas.map((area) => <section><h3>{area.title}</h3>{area.items.map((item) => <p>{item}</p>)}</section>)}</div>
    </section>

    <footer class="portfolio-footer">
      <p class="footer-mark">YH.</p><h2>Let’s talk.</h2><p>Open to conversations about cybersecurity, student projects, CTFs, and opportunities to learn by building.</p>
      <a class="footer-email" href="mailto:2503587D@student.tp.edu.sg">2503587D@student.tp.edu.sg ↗</a>
      <div class="footer-bottom"><span>© 2026 Yaohan</span><span>Temasek Polytechnic · Singapore</span><span>Built with care</span></div>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const loader = document.querySelector('[data-entry-loader]');
      if (!loader) return;

      const enter = loader.querySelector('[data-loader-enter]');
      const count = loader.querySelector('[data-loader-count]');
      const status = loader.querySelector('[data-loader-status]');
      const canvas = loader.querySelector('[data-world-canvas]');
      const map = loader.querySelector('[data-world-map]');
      const context = canvas?.getContext('2d', { alpha: false });
      const page = document.querySelector('main');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let progress = 0;
      let ready = false;
      let departed = false;
      let frame;
      let lastDrawnProgress = -1;
      const startedAt = performance.now();
      const minimumTime = reduceMotion ? 160 : 3200;
      const gridSize = 48;
      const cellSize = 6;

      document.documentElement.classList.add('entry-is-loading');
      page?.setAttribute('inert', '');

      const noise = (x, y, salt = 0) => {
        const value = Math.sin(x * 12.9898 + y * 78.233 + salt * 37.719) * 43758.5453;
        return value - Math.floor(value);
      };

      const drawWorld = (value) => {
        if (!context || value === lastDrawnProgress) return;
        lastDrawnProgress = value;
        context.imageSmoothingEnabled = false;
        context.fillStyle = '#020202';
        context.fillRect(0, 0, canvas.width, canvas.height);

        const centre = Math.floor(gridSize / 2);
        if (value === 0) return;
        const outerRadius = Math.max(1, Math.ceil((value / 100) * (gridSize / 2 - 2)));
        const innerRadius = Math.max(1, Math.floor(outerRadius * .55));
        for (let y = 0; y < gridSize; y += 1) {
          for (let x = 0; x < gridSize; x += 1) {
            const distance = Math.max(Math.abs(x - centre), Math.abs(y - centre));
            const raggedEdge = Math.floor(noise(x, y, 4) * 3) - 1;
            if (distance > outerRadius + (distance >= outerRadius - 1 ? raggedEdge : 0)) continue;
            const isInner = distance <= innerRadius + (distance >= innerRadius - 1 ? Math.floor(noise(x, y, 8) * 2) - 1 : 0);
            context.fillStyle = isInner ? '#f4f4f4' : (noise(x, y, 12) > .68 ? '#989898' : '#adadad');
            context.fillRect(x * cellSize, y * cellSize, cellSize, cellSize);
          }
        }

        if (innerRadius > 2) {
          const innerSize = (innerRadius * 2 + 1) * cellSize;
          const innerStart = (centre - innerRadius) * cellSize;
          context.strokeStyle = '#263d80';
          context.lineWidth = 7;
          context.strokeRect(innerStart - 4, innerStart - 4, innerSize + 8, innerSize + 8);
          context.strokeStyle = '#49ce20';
          context.lineWidth = 4;
          context.strokeRect(innerStart - 1, innerStart - 1, innerSize + 2, innerSize + 2);
        }
      };

      const phase = (value) => {
        if (value < 12) return 'Preparing spawn area...';
        if (value < 34) return 'Loading terrain...';
        if (value < 68) return 'Generating chunks...';
        if (value < 96) return 'Lighting world...';
        return 'World ready';
      };

      const render = (value) => {
        progress = Math.max(progress, Math.min(100, Math.round(value)));
        count.textContent = String(progress);
        status.textContent = phase(progress);
        loader.style.setProperty('--entry-progress', String(progress / 100));
        drawWorld(progress);
      };

      const tick = (now) => {
        if (!ready) {
          const elapsed = Math.min(1, (now - startedAt) / minimumTime);
          const eased = 1 - Math.pow(1 - elapsed, 2.1);
          render(Math.min(96, eased * 96));
          frame = requestAnimationFrame(tick);
        }
      };
      render(0);
      frame = requestAnimationFrame(tick);

      const heroImage = document.querySelector('.profile-portrait');
      const imageReady = !heroImage || heroImage.complete
        ? Promise.resolve()
        : new Promise((resolve) => {
            heroImage.addEventListener('load', resolve, { once: true });
            heroImage.addEventListener('error', resolve, { once: true });
          });
      const fontsReady = document.fonts?.ready ?? Promise.resolve();
      const timeReady = new Promise((resolve) => setTimeout(resolve, minimumTime));

      Promise.all([imageReady, fontsReady, timeReady]).then(() => {
        ready = true;
        cancelAnimationFrame(frame);
        render(100);
        loader.dataset.state = 'ready';
        enter.disabled = false;
        enter.focus({ preventScroll: true });
      });

      const leave = () => {
        if (!ready || departed) return;
        departed = true;
        loader.dataset.state = 'leaving';
        map?.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('entry-is-loading');
        page?.removeAttribute('inert');
        window.setTimeout(() => window.dispatchEvent(new CustomEvent('portfolio:entered')), reduceMotion ? 0 : 820);
        window.setTimeout(() => loader.remove(), reduceMotion ? 0 : 1300);
      };

      enter.addEventListener('click', leave);
      window.addEventListener('keydown', (event) => {
        if (ready && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          leave();
        }
      });

      window.addEventListener('pageshow', (event) => {
        if (event.persisted && departed) loader.remove();
      });
    })();
  </script>
</Layout>
